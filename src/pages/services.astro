---
// src/pages/services.astro
import fs from "fs/promises";
import path from "path";

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// 🚀 AJUSTE GODADDY: Carregamento dinâmico dos dados para evitar erros de build com arquivos estáticos ausentes
const servicesPath = path.join(process.cwd(), "public/assets/services.json");
const servicesFallbackPath = path.join(process.cwd(), "src/data/services.json");
const companyPath = path.join(process.cwd(), "public/assets/company.json");
const companyFallbackPath = path.join(process.cwd(), "src/data/company.json");

let servicesData: any[] = [];
let company: any = {};

// Carrega dados de Serviços
try {
  const rawServices = await fs.readFile(servicesPath, "utf8");
  servicesData = JSON.parse(rawServices);
} catch {
  try {
    const fallbackServices = await fs.readFile(servicesFallbackPath, "utf8");
    servicesData = JSON.parse(fallbackServices);
  } catch {
    servicesData = [];
  }
}

// Carrega dados da Empresa
try {
  const rawCompany = await fs.readFile(companyPath, "utf8");
  company = JSON.parse(rawCompany);
} catch {
  try {
    const fallbackCompany = await fs.readFile(companyFallbackPath, "utf8");
    company = JSON.parse(fallbackCompany);
  } catch {
    company = {
      name: "A-Plus Pavers & Grass",
      description: "Quality installation and long-lasting results",
      address: { serviceArea: "Orlando" }
    };
  }
}

const breadcrumbData = [
    { label: "Home", href: "/" },
    { label: "Services", current: true },
];
---

<Layout
    title={`Our Services | ${company.name}`}
    description={company.description}
>
    <Header
        headerTitle="Our Services"
        headerSubtitle={`Explore what we can do for your property in ${company.address?.serviceArea || "Orlando"}`}
        breadcrumb={breadcrumbData}
        isHome={false}
        showServicesLinks={false}
    />

    <div id="services" class="max-w-6xl mx-auto px-4 py-8">
        <div class="grid gap-6 md:grid-cols-3">
            {
                servicesData.map((service: any) => {
                    const cover = service.coverImage ?? null;
                    const features = Array.isArray(service.features) ? service.features : [];

                    return (
                        <article class="rounded-3xl border border-gray-200 bg-white shadow-sm overflow-hidden transition hover:-translate-y-1 hover:shadow-lg">
                            {cover ? (
                                <img
                                    src={cover}
                                    alt={`${service.title} project image`}
                                    class="h-48 w-full object-cover"
                                    loading="lazy"
                                />
                            ) : (
                                <div class="flex h-48 w-full items-center justify-center bg-[#eef6ff] px-4 text-center">
                                    <div class="space-y-2">
                                        <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-[#dbeafe] text-[#328cc1] text-lg">
                                            📷
                                        </div>
                                        <p class="text-sm font-semibold text-[#0b3c5d]">
                                            {service.title} image coming soon
                                        </p>
                                    </div>
                                </div>
                            )}
                            <div class="p-6">
                                <h2 class="text-xl font-bold text-[#0b3c5d] mb-3">
                                    {service.title}
                                </h2>
                                <p class="text-gray-600 leading-relaxed mb-5 whitespace-pre-line">
                                    {service.description}
                                </p>
                                <ul class="space-y-2 text-sm text-gray-600 mb-6">
                                    {features.map((feature: string) => (
                                        <li class="flex items-start gap-2">
                                            <span class="mt-1 text-[#328cc1]">
                                                •
                                            </span>
                                            {feature}
                                        </li>
                                    ))}
                                </ul>
                                <a
                                    href={`/services/${service.id}`}
                                    class="inline-flex items-center justify-center gap-2 rounded-full bg-[#0b3c5d] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#2570a2]"
                                >
                                    Learn more
                                    <span aria-hidden="true">→</span>
                                </a>
                            </div>
                        </article>
                    );
                })
            }
        </div>
    </div>
    <Footer />
</Layout>