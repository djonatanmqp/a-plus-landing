---
// Importação dos componentes estruturais da página
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import { getCompanyData, getServicesData } from "../lib/firebase-admin";

// Fallback da Empresa
const defaultCompany = {
  name: "A-Plus Pavers & Grass",
  description: "QUALITY PAVERS & SYNTHETIC GRASS INSTALLATION",
  contact: { phone: "", phoneRaw: "", facetime: "", email: "" },
  address: { full: "", serviceArea: "Orlando", city: "Orlando", state: "FL" },
  links: { googleReview: "", facebook: "", instagram: "", tiktok: "", googleMapsEmbed: "" }
};

const fetchedCompany = await getCompanyData();
const company = fetchedCompany || defaultCompany;

const servicesData = (await getServicesData()) || [];

const breadcrumbData = [
  { label: "Home", url: "/" },
  { label: "Services", url: "/services" }
];
---

<Layout
    title={`Our Services | ${company.name}`}
    description={company.description}
>
    <Header
        headerTitle="Our Services"
        headerSubtitle={`Explore what we can do for your property in ${company.address?.serviceArea || "Orlando"}`}
        breadcrumb={breadcrumbData}
        isHome={false}
        showServicesLinks={false}
    />

    <div id="services" class="max-w-6xl mx-auto px-4 py-8">
        <div class="grid gap-6 md:grid-cols-3">
            {
                servicesData.map((service: any) => {
                    const cover = service.coverImage ?? null;
                    // Exibe preferencialmente a shortDescription; usa subtitle ou description se ainda não foi preenchido
                    const cardDescription = service.shortDescription || service.subtitle || service.description;

                    return (
                        <article class="flex flex-col justify-between rounded-3xl border border-gray-200 bg-white shadow-sm overflow-hidden transition hover:-translate-y-1 hover:shadow-lg">
                            <div>
                                {cover ? (
                                    <img
                                        src={cover}
                                        alt={`${service.title} project image`}
                                        class="h-48 w-full object-cover"
                                        loading="lazy"
                                    />
                                ) : (
                                    <div class="flex h-48 w-full items-center justify-center bg-[#eef6ff] px-4 text-center">
                                        <div class="space-y-2">
                                            <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-[#dbeafe] text-[#328cc1] text-lg">
                                                📷
                                            </div>
                                            <p class="text-sm font-semibold text-[#0b3c5d]">
                                                {service.title} image coming soon
                                            </p>
                                        </div>
                                    </div>
                                )}
                                <div class="p-6">
                                    <h2 class="text-xl font-bold text-[#0b3c5d] mb-3">
                                        {service.title}
                                    </h2>
                                    
                                    {/* Descrição Curta (1-2 frases no máximo) */}
                                    <p class="text-gray-600 text-sm leading-relaxed mb-6">
                                        {cardDescription}
                                    </p>
                                </div>
                            </div>

                            {/* Botão para forçar a navegação */}
                            <div class="px-6 pb-6 pt-0">
                                <a
                                    href={`/services/${service.id}`}
                                    class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#0b3c5d] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#2570a2]"
                                >
                                    Learn more
                                    <span aria-hidden="true">→</span>
                                </a>
                            </div>
                        </article>
                    );
                })
            }
        </div>
    </div>
    <Footer />
</Layout>