---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import servicesData from "../data/services.json";
import company from "../data/company.json"; // 🚀 Importa os dados globais da empresa

const breadcrumbData = [
    { label: "Home", href: "/" },
    { label: "Services", current: true },
];
---

<Layout
    title={`Our Services | ${company.name}`}
    description={company.description}
>
    <Header
        headerTitle="Our Services"
        headerSubtitle={`Explore what we can do for your property in ${company.address.serviceArea}`}
        breadcrumb={breadcrumbData}
        isHome={false}
        showServicesLinks={false}
    />

    <div id="services" class="max-w-6xl mx-auto px-4 py-8">
        <div class="grid gap-6 md:grid-cols-3">
            {
                servicesData.map((service) => {
                    const cover = service.coverImage ?? null;

                    return (
                        <article class="rounded-3xl border border-gray-200 bg-white shadow-sm overflow-hidden transition hover:-translate-y-1 hover:shadow-lg">
                            {cover ? (
                                <img
                                    src={cover}
                                    alt={`${service.title} project image`}
                                    class="h-48 w-full object-cover"
                                    loading="lazy"
                                />
                            ) : (
                                <div class="flex h-48 w-full items-center justify-center bg-[#eef6ff] px-4 text-center">
                                    <div class="space-y-2">
                                        <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-[#dbeafe] text-[#328cc1] text-lg">
                                            📷
                                        </div>
                                        <p class="text-sm font-semibold text-[#0b3c5d]">
                                            {service.title} image coming soon
                                        </p>
                                    </div>
                                </div>
                            )}
                            <div class="p-6">
                                <h2 class="text-xl font-bold text-[#0b3c5d] mb-3">
                                    {service.title}
                                </h2>
                                <p class="text-gray-600 leading-relaxed mb-5 whitespace-pre-line">
                                    {service.description}
                                </p>
                                <ul class="space-y-2 text-sm text-gray-600 mb-6">
                                    {service.features.map((feature) => (
                                        <li class="flex items-start gap-2">
                                            <span class="mt-1 text-[#328cc1]">
                                                •
                                            </span>
                                            {feature}
                                        </li>
                                    ))}
                                </ul>
                                <a
                                    href={`/services/${service.id}`}
                                    class="inline-flex items-center justify-center gap-2 rounded-full bg-[#0b3c5d] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#2570a2]"
                                >
                                    Learn more
                                    <span aria-hidden="true">→</span>
                                </a>
                            </div>
                        </article>
                    );
                })
            }
        </div>
    </div>
    <Footer />
</Layout>
