---
import { parseCookies, validateAdminToken, readServicesConfig, listTestimonials, SESSION_COOKIE_NAME } from "../lib/admin.ts";

const cookies = parseCookies(Astro.request.headers.get("cookie"));
const isLoggedIn = validateAdminToken(cookies[SESSION_COOKIE_NAME]);
const servicesData = isLoggedIn ? await readServicesConfig() : [];
const testimonials = isLoggedIn ? await listTestimonials() : [];
const message = Astro.url.searchParams.get("message") ?? "";
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin | A-Plus Landing</title>
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <main class="max-w-6xl mx-auto p-6">
      <a href="/" class="inline-block text-sm text-slate-600 hover:text-slate-900 mb-6">← Voltar ao site</a>
      <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h1 class="text-3xl font-bold text-[#0b3c5d]">Painel Administrativo</h1>
          <p class="text-sm text-slate-600 mt-1">Gerencie galerias e depoimentos sem banco de dados.</p>
        </div>
        {isLoggedIn ? (
          <form method="POST" action="/admin/api/logout">
            <button
              type="submit"
              class="rounded-full bg-[#0b3c5d] px-5 py-2 text-sm font-semibold text-white transition hover:bg-[#2570a2]"
            >
              Sair
            </button>
          </form>
        ) : null}
      </div>

      {message ? (
        <div class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-slate-800">
          {message}
        </div>
      ) : null}

      {!isLoggedIn ? (
        <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-semibold text-[#0b3c5d] mb-4">Entrar</h2>
          <form method="POST" action="/admin/api/login" class="grid gap-4">
            <label class="grid gap-2 text-sm text-slate-700">
              Usuário
              <input
                name="username"
                type="text"
                required
                class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm focus:border-[#328cc1] focus:outline-none focus:ring-2 focus:ring-[#328cc1]/20"
              />
            </label>
            <label class="grid gap-2 text-sm text-slate-700">
              Senha
              <input
                name="password"
                type="password"
                required
                class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm focus:border-[#328cc1] focus:outline-none focus:ring-2 focus:ring-[#328cc1]/20"
              />
            </label>
            <button
              type="submit"
              class="rounded-full bg-[#328cc1] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#0b3c5d]"
            >
              Entrar
            </button>
          </form>
          <p class="mt-4 text-xs text-slate-500">Use as credenciais definidas em <code class="rounded bg-slate-100 px-2 py-1">.env</code>.</p>
        </section>
      ) : (
        <div class="space-y-8">
          <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
            <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h2 class="text-2xl font-semibold text-[#0b3c5d]">Galerias de serviços</h2>
                <p class="text-sm text-slate-600">Envie imagens para hero, cover ou adiciona novas fotos ao serviço.</p>
              </div>
              <span class="rounded-full bg-slate-100 px-4 py-2 text-sm text-slate-700">{servicesData.length} serviços configurados</span>
            </div>

            <form method="POST" action="/admin/api/service" enctype="multipart/form-data" class="grid gap-5">
              <label class="grid gap-2 text-sm text-slate-700">
                Serviço
                <select name="serviceId" required class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm focus:border-[#328cc1] focus:outline-none focus:ring-2 focus:ring-[#328cc1]/20">
                  <option value="">Escolha um serviço</option>
                  {servicesData.map((service) => (
                    <option value={service.id}>{service.title}</option>
                  ))}
                </select>
              </label>

              <div class="grid gap-4 md:grid-cols-2">
                <label class="grid gap-2 text-sm text-slate-700">
                  Hero image
                  <input type="file" name="heroImage" accept="image/*" class="text-sm text-slate-600" />
                </label>
                <label class="grid gap-2 text-sm text-slate-700">
                  Cover image
                  <input type="file" name="coverImage" accept="image/*" class="text-sm text-slate-600" />
                </label>
              </div>

              <label class="grid gap-2 text-sm text-slate-700">
                Imagens de galeria (múltiplas)
                <input type="file" name="galleryImages" accept="image/*" multiple class="text-sm text-slate-600" />
              </label>

              <button type="submit" class="w-full rounded-full bg-[#328cc1] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#0b3c5d]">
                Atualizar serviço
              </button>
            </form>
          </section>

          <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
            <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h2 class="text-2xl font-semibold text-[#0b3c5d]">Depoimentos</h2>
                <p class="text-sm text-slate-600">Crie depoimentos com fotos Before/After e data do serviço no formato mês/ano.</p>
              </div>
              <span class="rounded-full bg-slate-100 px-4 py-2 text-sm text-slate-700">{testimonials.length} depoimentos</span>
            </div>

            <form method="POST" action="/admin/api/testimonial" enctype="multipart/form-data" class="grid gap-5">
              <div class="grid gap-4 md:grid-cols-2">
                <label class="grid gap-2 text-sm text-slate-700">
                  Cliente
                  <input name="clientName" type="text" required class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm focus:border-[#328cc1] focus:outline-none focus:ring-2 focus:ring-[#328cc1]/20" />
                </label>
                <label class="grid gap-2 text-sm text-slate-700">
                  Serviço
                  <select name="serviceType" required class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm focus:border-[#328cc1] focus:outline-none focus:ring-2 focus:ring-[#328cc1]/20">
                    <option value="">Escolha um serviço</option>
                    {servicesData.map((service) => (
                      <option value={service.title}>{service.title}</option>
                    ))}
                    <option value="Other">Outro</option>
                  </select>
                </label>
              </div>

              <div class="grid gap-4 md:grid-cols-2">
                <label class="grid gap-2 text-sm text-slate-700">
                  Mês/Ano do serviço
                  <input name="date" type="month" required class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm focus:border-[#328cc1] focus:outline-none focus:ring-2 focus:ring-[#328cc1]/20" />
                </label>
                <div class="grid gap-4">
                  <label class="grid gap-2 text-sm text-slate-700">
                    Foto Before
                    <input name="beforeImage" type="file" accept="image/*" required class="text-sm text-slate-600" />
                  </label>
                  <label class="grid gap-2 text-sm text-slate-700">
                    Foto After
                    <input name="afterImage" type="file" accept="image/*" required class="text-sm text-slate-600" />
                  </label>
                </div>
              </div>

              <label class="grid gap-2 text-sm text-slate-700">
                Depoimento
                <textarea name="message" rows="5" required class="w-full rounded-3xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm leading-6 focus:border-[#328cc1] focus:outline-none focus:ring-2 focus:ring-[#328cc1]/20"></textarea>
              </label>

              <button type="submit" class="w-full rounded-full bg-[#328cc1] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#0b3c5d]">
                Adicionar depoimento
              </button>
            </form>
          </section>
        </div>
      )}
    </main>
  </body>
</html>
