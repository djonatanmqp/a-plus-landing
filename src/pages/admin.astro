---
// src/pages/admin.astro
import {
  parseCookies,
  validateAdminToken,
  readServicesConfig,
  SESSION_COOKIE_NAME,
} from "../lib/admin.ts";
import Layout from "../layouts/Layout.astro";

// IMPORTAÇÃO DOS ÍCONES UNIFICADOS (Coleção MDI)
import LogoutIcon from "~icons/mdi/logout";
import CloudUploadIcon from "~icons/mdi/cloud-upload";
import PlusIcon from "~icons/mdi/plus";
import ImageIcon from "~icons/mdi/image";

const cookies = parseCookies(Astro.request.headers.get("cookie"));
const isLoggedIn = validateAdminToken(cookies[SESSION_COOKIE_NAME]);
const servicesData = isLoggedIn ? await readServicesConfig() : [];
const message = Astro.url.searchParams.get("message") ?? "";
---

<Layout title="Admin | A-Plus Landing">
  <header class="border-b bg-white">
    <div
      class="max-w-6xl mx-auto px-6 py-6 flex items-center justify-between gap-4"
    >
      <div class="flex items-center gap-4">
        <img src="/logo.png" alt="A-Plus logo" class="w-20 h-auto" />
        <div>
          <div class="text-lg font-extrabold text-[#0b3c5d] leading-none">
            A-PLUS PAVERS & GRASS
          </div>
          <div class="text-sm text-slate-600">Control Panel</div>
        </div>
      </div>
      <a href="/" class="text-sm text-slate-600 hover:text-slate-900"
        >← Back to site</a
      >
    </div>
  </header>

  <main class="max-w-6xl mx-auto p-6">
    <div
      class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <h1 class="text-3xl font-bold text-[#0b3c5d]">Admin Panel</h1>
        <p class="text-sm text-slate-600 mt-1">
          Manage galleries and testimonials without a database.
        </p>
      </div>
      {
        isLoggedIn && (
          <form method="POST" action="/admin/api/logout">
            <button
              type="submit"
              class="flex items-center gap-2 rounded-full bg-[#0b3c5d] px-5 py-2 text-sm font-semibold text-white transition hover:bg-[#2570a2]"
            >
              <LogoutIcon class="w-4 h-4" />
              Sign Out
            </button>
          </form>
        )
      }
    </div>

    {
      message && (
        <div class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-slate-800">
          {message}
        </div>
      )
    }

    {
      !isLoggedIn ? (
        <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-semibold text-[#0b3c5d] mb-4">Login</h2>
          <form method="POST" action="/admin/api/login" class="grid gap-4">
            <label class="grid gap-2 text-sm text-slate-700">
              Username{" "}
              <input
                name="username"
                type="text"
                required
                class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3"
              />
            </label>
            <label class="grid gap-2 text-sm text-slate-700">
              Password{" "}
              <input
                name="password"
                type="password"
                required
                class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3"
              />
            </label>
            <button
              type="submit"
              class="rounded-full bg-[#328cc1] px-5 py-3 text-sm font-semibold text-white"
            >
              Sign In
            </button>
          </form>
        </section>
      ) : (
        <div class="space-y-8">
          <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
            <h2 class="text-2xl font-semibold text-[#0b3c5d] mb-4">
              Service Galleries
            </h2>
            <p class="text-sm text-slate-600 mb-6">
              Upload images per service to update the public gallery. <strong class="text-[#0b3c5d]">Note: Only JPG/JPEG images are allowed.</strong>
            </p>
            <form
              method="POST"
              action="/admin/api/service"
              enctype="multipart/form-data"
              class="grid gap-5"
            >
              <select
                name="serviceId"
                required
                class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm"
              >
                <option value="">Select a service</option>
                {servicesData.map((s: any) => (
                  <option value={s.id}>{s.title}</option>
                ))}
              </select>

              <div class="grid gap-4 md:grid-cols-2">
                {["heroImage", "coverImage"].map((name) => (
                  <label class="grid gap-2 text-sm text-slate-700 cursor-pointer">
                    {name
                      .replace(/([A-Z])/g, " $1")
                      .replace(/^./, (str) => str.toUpperCase())} (JPG)
                    <div class="relative flex items-center gap-4 rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 overflow-hidden">
                      <img
                        src=""
                        alt="Preview"
                        class="hidden w-12 h-12 object-cover rounded-md border border-slate-200 fn-preview-img"
                      />
                      <div class="flex items-center gap-3 text-slate-400 fn-placeholder-box">
                        <ImageIcon class="w-6 h-6 text-slate-400" />
                        <span class="text-xs truncate max-w-[150px] fn-filename-text">
                          No file chosen
                        </span>
                      </div>
                      <input
                        type="file"
                        name={name}
                        accept=".jpg, .jpeg"
                        class="hidden fn-file-input"
                      />
                    </div>
                  </label>
                ))}
              </div>
              <label class="grid gap-2 text-sm text-slate-700 cursor-pointer">
                Add Gallery Photos (JPG only - Will append to current photos)
                <div class="relative flex items-center gap-4 rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-3 overflow-hidden">
                  <div class="flex items-center gap-3 text-slate-400">
                    <ImageIcon class="w-6 h-6 text-slate-400" />
                    <span class="text-xs truncate max-w-[200px] fn-gallery-text">
                      No files chosen
                    </span>
                  </div>
                  <input
                    type="file"
                    name="galleryImages"
                    accept=".jpg, .jpeg"
                    multiple
                    class="hidden fn-gallery-input"
                  />
                </div>
              </label>
              <button
                type="submit"
                class="flex w-full items-center justify-center gap-2 rounded-full bg-[#328cc1] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#0b3c5d]"
              >
                <CloudUploadIcon class="w-4 h-4" />
                Update Service
              </button>
            </form>
          </section>

          <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
            <h2 class="text-2xl font-semibold text-[#0b3c5d] mb-6">
              Testimonials
            </h2>
            <form
              method="POST"
              action="/admin/api/testimonial"
              enctype="multipart/form-data"
              class="grid gap-5"
            >
              <div class="grid gap-4 md:grid-cols-2">
                <input
                  name="clientName"
                  placeholder="Client Name"
                  type="text"
                  required
                  class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm"
                />
                <select
                  name="serviceType"
                  required
                  class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm"
                >
                  <option value="">Select Service</option>
                  {servicesData.map((s: any) => (
                    <option value={s.title}>{s.title}</option>
                  ))}
                </select>
              </div>

              <div class="grid gap-4 md:grid-cols-2">
                <input
                  name="city"
                  placeholder="City"
                  type="text"
                  required
                  class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm"
                />
                <input
                  name="state"
                  placeholder="State"
                  type="text"
                  required
                  class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm"
                />
              </div>

              <input
                name="date"
                type="month"
                required
                class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm"
              />

              <div class="grid gap-4 md:grid-cols-2">
                {["beforeImage", "afterImage"].map((name) => (
                  <label class="grid gap-2 text-sm text-slate-700 cursor-pointer">
                    {name === "beforeImage" ? "Before Photo" : "After Photo"} (JPG)
                    <div class="relative flex items-center gap-4 rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 overflow-hidden">
                      <img
                        src=""
                        alt="Preview"
                        class="hidden w-12 h-12 object-cover rounded-md border border-slate-200 fn-preview-img"
                      />
                      <div class="flex items-center gap-3 text-slate-400 fn-placeholder-box">
                        <ImageIcon class="w-6 h-6 text-slate-400" />
                        <span class="text-xs truncate max-w-[150px] fn-filename-text">
                          No file chosen
                        </span>
                      </div>
                      <input
                        type="file"
                        name={name}
                        accept=".jpg, .jpeg"
                        required
                        class="hidden fn-file-input"
                      />
                    </div>
                  </label>
                ))}
              </div>
              <textarea
                name="message"
                placeholder="Testimonial text..."
                rows="4"
                required
                class="w-full rounded-3xl border border-slate-300 px-4 py-3 text-sm"
              />
              <button
                type="submit"
                class="flex w-full items-center justify-center gap-2 rounded-full bg-[#328cc1] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#0b3c5d]"
              >
                <PlusIcon class="w-4 h-4" />
                Add Testimonial
              </button>
            </form>
          </section>
        </div>
      )
    }
  </main>
</Layout>

{/* 🚀 Script encapsulado para gerenciar os comportamentos sem usar strings inline problemáticas */}
<script>
  // 1. Gerenciador de Previews Individuais (Hero, Cover, Before, After)
  const fileInputs = document.querySelectorAll('.fn-file-input');
  fileInputs.forEach((input) => {
    input.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (!target.files || target.files.length === 0) return;

      const file = target.files[0];
      const parent = target.parentElement;
      if (!parent) return;

      const img = parent.querySelector('.fn-preview-img') as HTMLImageElement;
      const placeholder = parent.querySelector('.fn-placeholder-box') as HTMLElement;
      const filenameSpan = parent.querySelector('.fn-filename-text') as HTMLElement;

      if (img && placeholder && filenameSpan) {
        const reader = new FileReader();
        reader.onload = (event) => {
          if (event.target?.result) {
            img.src = event.target.result as string;
            img.classList.remove('hidden');
            placeholder.classList.add('hidden');
          }
        };
        reader.readAsDataURL(file);
        filenameSpan.textContent = file.name;
      }
    });
  });

  // 2. Gerenciador de Feedback da Galeria Múltipla
  const galleryInputs = document.querySelectorAll('.fn-gallery-input');
  galleryInputs.forEach((input) => {
    input.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (!target.files) return;

      const parent = target.parentElement;
      if (!parent) return;

      const textSpan = parent.querySelector('.fn-gallery-text');
      if (textSpan) {
        textSpan.textContent = `${target.files.length} file(s) selected`;
      }
    });
  });
</script>