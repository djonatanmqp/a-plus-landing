---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import servicesData from "../../data/services.json";
import Phone from "~icons/mdi/phone";
import Video from "~icons/mdi/video";

// 1. Busca o serviço correto pelo ID vindo da URL
const service = servicesData.find((item) => item.id === Astro.params.id);
if (!service) {
    throw new Error(`Service not found: ${Astro.params.id}`);
}

// 2. Define os metadados da página baseados no serviço encontrado
const pageTitle = `${service.title} Orlando | A-Plus Pavers & Grass`;
const pageDescription = `${service.description} Learn how A-Plus delivers quality installation, local service and long-lasting results for Orlando homes.`;
const galleryImages = Array.isArray(service.images) ? service.images : [];
const coverImage = service.coverImage ?? null;

// 3. Monta os dados do Breadcrumb
const breadcrumbData = [
    { label: "Home", href: "/" },
    { label: "Services", href: "/services" },
    { label: service.title, current: true },
];
---

<Layout title={pageTitle} description={pageDescription}>
    <Header
        headerTitle={service.title}
        headerSubtitle={service.description}
        breadcrumb={breadcrumbData}
        isHome={false}
        showServicesLinks={false}
    />
    <main class="max-w-6xl mx-auto px-4 py-8">
        <section
            class="rounded-3xl bg-white p-8 shadow-sm border border-gray-100 mb-10"
        >
            <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] items-start">
                <div>
                    <p
                        class="text-sm uppercase tracking-widest text-[#328cc1] font-bold"
                    >
                        {service.title}
                    </p>
                    <h1
                        class="mt-3 text-4xl font-extrabold text-[#0b3c5d] leading-tight"
                    >
                        {service.title} in Orlando
                    </h1>
                    <p
                        class="mt-4 text-gray-600 leading-relaxed text-base sm:text-lg"
                    >
                        {service.details}
                    </p>
                    <div class="mt-8 grid gap-4 sm:grid-cols-2">
                        <a
                            href="tel:4071234567"
                            class="inline-flex items-center justify-center gap-3 rounded-full bg-[#0b3c5d] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#2570a2]"
                        >
                            <Phone class="w-5 h-5 text-gray-400" />
                            Call now
                        </a>
                        <a
                            href="facetime:4071234567"
                            class="inline-flex items-center justify-center gap-3 rounded-full border border-[#328cc1] bg-white px-5 py-3 text-sm font-semibold text-[#328cc1] transition hover:bg-[#ebf4ff]"
                        >
                            <Video class="w-5 h-5 text-gray-400" />
                            FaceTime
                        </a>
                    </div>
                </div>
                <div
                    class="rounded-3xl overflow-hidden border border-gray-200 bg-gray-50 aspect-video lg:aspect-auto lg:h-full min-h-[320px]"
                >
                    {
                        coverImage ? (
                            <img
                                src={coverImage}
                                alt={`${service.title} cover`}
                                class="h-full w-full object-cover"
                                loading="lazy"
                                onerror={`this.onerror=null; this.src='https://placehold.co/600x400?text=${encodeURIComponent(service.title)}+Cover';`}
                            />
                        ) : (
                            <div class="flex h-full min-h-[320px] items-center justify-center bg-[#eef6ff] px-4 text-center">
                                <div class="space-y-2">
                                    <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-[#dbeafe] text-[#328cc1] text-lg">
                                        📷
                                    </div>
                                    <p class="text-sm font-semibold text-[#0b3c5d]">
                                        Nenhuma imagem disponível ainda para este serviço.
                                    </p>
                                </div>
                            </div>
                        )
                    }
                </div>
            </div>
        </section>

        <section
            class="rounded-3xl bg-white p-8 shadow-sm border border-gray-100 mb-10"
        >
            <h2 class="text-3xl font-extrabold text-[#0b3c5d] mb-6">
                Why Orlando homeowners choose this service
            </h2>
            <ul class="grid gap-4 text-gray-600 text-base sm:grid-cols-2">
                {
                    service.features.map((feature) => (
                        <li class="rounded-2xl border border-gray-200 bg-gray-50 p-4">
                            {feature}
                        </li>
                    ))
                }
            </ul>
        </section>

        {/* 🚀 SEÇÃO DE GALERIA ATUALIZADA: MÁXIMO 6 IMAGENS + DETECTOR DE MODAL */}
        <section
            class="rounded-3xl bg-white p-8 shadow-sm border border-gray-100 mb-10"
        >
            <h2 class="text-3xl font-extrabold text-[#0b3c5d] mb-4">
                Project Gallery
            </h2>
            {
                galleryImages.length > 0 ? (
                    <div>
                        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                            {galleryImages.slice(0, 6).map((image, index) => (
                                <figure class="overflow-hidden rounded-3xl border border-gray-200 bg-gray-50 aspect-video cursor-pointer transform transition duration-300 hover:scale-[1.02] hover:shadow-md js-gallery-trigger">
                                    <img
                                        loading="lazy"
                                        src={image}
                                        alt={`${service.title} project photo`}
                                        class="h-full w-full object-cover"
                                        onerror={`this.onerror=null; this.src='https://placehold.co/600x400?text=${encodeURIComponent(service.title)}+Image+${index + 1}';`}
                                    />
                                </figure>
                            ))}
                        </div>

                        {galleryImages.length > 6 && (
                            <div class="mt-8 text-center">
                                <button
                                    id="open-gallery-modal"
                                    class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-[#0b3c5d] bg-white px-6 py-3 text-sm font-bold text-[#0b3c5d] transition hover:bg-[#0b3c5d] hover:text-white group"
                                >
                                    <span>View All Photos (+{galleryImages.length - 6})</span>
                                    <span class="transform transition-transform group-hover:translate-x-1">→</span>
                                </button>
                            </div>
                        )}
                    </div>
                ) : (
                    <div class="rounded-3xl border border-dashed border-[#328cc1] bg-[#eff8ff] p-10 text-center text-[#0b3c5d]">
                        <div class="mx-auto mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-[#dbeafe] text-[#328cc1] text-lg">
                            📷
                        </div>
                        <p class="text-lg font-semibold">Galeria em breve</p>
                        <p class="mt-2 text-sm text-gray-600 max-w-xl mx-auto">
                            Ainda não temos imagens desse serviço. Faça o upload
                            pela área administrativa e elas aparecerão aqui e na
                            página de serviços.
                        </p>
                    </div>
                )
            }
        </section>

        <section
            id="faq"
            class="rounded-3xl bg-white p-8 shadow-sm border border-gray-100 mb-10"
        >
            <h2 class="text-3xl font-extrabold text-[#0b3c5d] mb-6">
                Frequently Asked Questions
            </h2>
            <div class="space-y-6">
                {
                    service.faq.map((item) => (
                        <div>
                            <h3 class="text-xl font-semibold text-[#0b3c5d] mb-2">
                                {item.question}
                            </h3>
                            <p class="text-gray-600 leading-relaxed">
                                {item.answer}
                            </p>
                        </div>
                    ))
                }
            </div>
        </section>

        <div
            class="rounded-3xl bg-[#eef6ff] p-8 text-center border border-[#dbeafe]"
        >
            <h3 class="text-2xl font-extrabold text-[#0b3c5d] mb-4">
                Ready for a local Orlando estimate?
            </h3>
            <p class="text-gray-700 mb-6">
                Call now or send us a message to schedule a free project review
                in the Orlando area.
            </p>
            <div
                class="md:inline-flex items-center gap-6 font-bold text-sm uppercase tracking-wider text-[#0b3c5d]"
            >
                <a
                    href="/#contact"
                    class="hover:text-[#328cc1] transition-colors drop-shadow-sm bg-[#0b3c5d] text-white px-4 py-2 rounded shadow-sm"
                    >Contact Us</a
                >
            </div>
        </div>
    </main>

    {/* 🚀 MODAL ESTRUTURAL DA GALERIA COMPLETA */}
    {
        galleryImages.length > 6 && (
            <div
                id="gallery-modal"
                class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4 backdrop-blur-sm"
            >
                <div class="relative w-full max-w-5xl rounded-3xl bg-white p-6 md:p-8 shadow-2xl flex flex-col max-h-[90vh]">
                    <div class="flex items-center justify-between border-b pb-4 mb-6">
                        <div>
                            <h3 class="text-2xl font-extrabold text-[#0b3c5d]">
                                {service.title} — Full Gallery
                            </h3>
                            <p class="text-sm text-gray-500 mt-1">
                                Showing all {galleryImages.length} project photos
                            </p>
                        </div>
                        <button
                            id="close-gallery-modal"
                            class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 text-gray-500 hover:bg-gray-200 hover:text-gray-800 transition"
                            aria-label="Close modal"
                        >
                            ✕
                        </button>
                    </div>

                    <div class="overflow-y-auto pr-2 grid gap-4 grid-cols-2 md:grid-cols-3 auto-rows-max flex-1 fn-custom-scrollbar">
                        {galleryImages.map((image, index) => (
                            <figure class="overflow-hidden rounded-2xl border border-gray-200 bg-gray-50 aspect-video">
                                <img
                                    loading="lazy"
                                    src={image}
                                    alt={`${service.title} complete gallery photo ${index + 1}`}
                                    class="h-full w-full object-cover"
                                    onerror={`this.onerror=null; this.src='https://placehold.co/600x400?text=${encodeURIComponent(service.title)}+Photo+${index + 1}';`}
                                />
                            </figure>
                        ))}
                    </div>
                </div>
            </div>
        )
    }

    <Footer />
</Layout>

{/* 🚀 SCRIPT DE COMPORTAMENTO INTERATIVO DO MODAL */}
<script>
    const modal = document.getElementById('gallery-modal');
    const openBtn = document.getElementById('open-gallery-modal');
    const closeBtn = document.getElementById('close-gallery-modal');

    if (openBtn && modal) {
        openBtn.addEventListener('click', () => {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        });
    }

    const triggers = document.querySelectorAll('.js-gallery-trigger');
    if (triggers.length > 0 && modal && openBtn) {
        triggers.forEach(trigger => {
            trigger.addEventListener('click', () => {
                // Instancia o mesmo gatilho do botão de ver tudo
                (openBtn as HTMLButtonElement).click();
            });
        });
    }

    if (closeBtn && modal) {
        const closeModal = () => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        };

        closeBtn.addEventListener('click', closeModal);

        modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
                closeModal();
            }
        });
    }
</script>

<style>
    .fn-custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .fn-custom-scrollbar::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }
    .fn-custom-scrollbar::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
    }
    .fn-custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }
</style>