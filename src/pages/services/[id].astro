---
// src/pages/services/[id].astro
import fs from "fs/promises";
import path from "path";

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ZoomModal from "../../components/ZoomModal.astro";
import Phone from "~icons/mdi/phone";
import Video from "~icons/mdi/video";

// 🚀 AJUSTE GODADDY: Leitura dinâmica das configurações para o build estático
const servicesPath = path.join(process.cwd(), "public/assets/services.json");
const servicesFallbackPath = path.join(process.cwd(), "src/data/services.json");
const companyPath = path.join(process.cwd(), "public/assets/company.json");
const companyFallbackPath = path.join(process.cwd(), "src/data/company.json");

let servicesData: any[] = [];
let company: any = {};

// Carrega os dados de Serviços
try {
  const rawServices = await fs.readFile(servicesPath, "utf8");
  servicesData = JSON.parse(rawServices);
} catch {
  try {
    const fallbackServices = await fs.readFile(servicesFallbackPath, "utf8");
    servicesData = JSON.parse(fallbackServices);
  } catch {
    servicesData = [];
  }
}

// Carrega os dados da Empresa
try {
  const rawCompany = await fs.readFile(companyPath, "utf8");
  company = JSON.parse(rawCompany);
} catch {
  try {
    const fallbackCompany = await fs.readFile(companyFallbackPath, "utf8");
    company = JSON.parse(fallbackCompany);
  } catch {
    company = {
      name: "A-Plus Pavers & Grass",
      contact: { phone: "", phoneRaw: "", email: "", facetime: "" },
      address: { serviceArea: "Orlando", full: "" }
    };
  }
}

// 🚀 ESSENCIAL: Como o Astro executa getStaticPaths primeiro no build,
// nós exportamos a função abaixo que mapeia todos os IDs de serviços disponíveis dinamicamente.
export async function getStaticPaths() {
  const fs = await import("fs/promises");
  const path = await import("path");

  const sPath = path.join(process.cwd(), "public/assets/services.json");
  const sFallbackPath = path.join(process.cwd(), "src/data/services.json");
  let sData: any[] = [];

  try {
    const raw = await fs.readFile(sPath, "utf8");
    sData = JSON.parse(raw);
  } catch {
    try {
      const fallbackRaw = await fs.readFile(sFallbackPath, "utf8");
      sData = JSON.parse(fallbackRaw);
    } catch {
      sData = [];
    }
  }

  return sData.map((item: any) => ({
    params: { id: item.id },
    props: { serviceId: item.id } // Passamos o id para encontrar as propriedades corretas em tempo de render
  }));
}

// Busca o serviço específico baseado no parâmetro da rota
const service = servicesData.find((item) => item.id === Astro.params.id);
if (!service) {
    throw new Error(`Service not found: ${Astro.params.id}`);
}

const pageTitle = `${service.title} | ${company.address?.serviceArea || "Orlando"} | ${company.name}`;
const pageDescription = `${service.description} Learn how ${company.name} delivers quality installation and long-lasting results for homes in ${company.address?.serviceArea || "Orlando"}.`;
const galleryImages = Array.isArray(service.images) ? service.images : [];
const coverImage = service.coverImage ?? null;

const breadcrumbData = [
    { label: "Home", href: "/" },
    { label: "Services", href: "/services" },
    { label: service.title, current: true },
];
---

<Layout title={pageTitle} description={pageDescription}>
    <Header
        headerTitle={service.title}
        headerSubtitle={service.tagline}
        breadcrumb={breadcrumbData}
        isHome={false}
        showServicesLinks={false}
    />

    <main class="max-w-6xl mx-auto px-4 py-8">
        <section class="rounded-3xl bg-white p-6 sm:p-8 shadow-sm border border-gray-100 mb-10">
            <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] items-start">
                <div>
                    <p class="text-sm uppercase tracking-widest text-[#328cc1] font-bold">{service.title}</p>
                    <h1 class="mt-3 text-3xl sm:text-4xl font-extrabold text-[#0b3c5d] leading-tight">{service.title} in {company.address?.serviceArea || "Orlando"}</h1>
                    <p class="mt-4 text-gray-600 leading-relaxed text-base sm:text-lg whitespace-pre-line">{service.details}</p>

                    <div class="mt-8 grid gap-4 sm:grid-cols-2">
                        <a href={`tel:${company.contact?.phoneRaw}`} class="inline-flex items-center justify-center gap-3 rounded-full bg-[#0b3c5d] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#2570a2]">
                            <Phone class="w-5 h-5 text-gray-400" /> Call now
                        </a>
                        <a href={`facetime:${company.contact?.facetime}`} class="inline-flex items-center justify-center gap-3 rounded-full border border-[#328cc1] bg-white px-5 py-3 text-sm font-semibold text-[#328cc1] transition hover:bg-[#ebf4ff]">
                            <Video class="w-5 h-5 text-gray-400" /> FaceTime
                        </a>
                    </div>
                </div>

                <div class="rounded-3xl overflow-hidden border border-gray-200 bg-gray-50 aspect-video w-full lg:aspect-auto lg:h-full lg:min-h-[320px]">
                    {coverImage ? (
                        <img 
                            src={coverImage} 
                            alt={`${service.title} cover`} 
                            class="js-zoom-trigger h-full w-full object-cover cursor-zoom-in" 
                            loading="lazy" 
                        />
                    ) : (
                        <div class="flex w-full h-full items-center justify-center bg-[#eef6ff]">📷</div>
                    )}
                </div>
            </div>
        </section>

        <section class="rounded-3xl bg-white p-6 sm:p-8 shadow-sm border border-gray-100 mb-10">
            <h2 class="text-3xl font-extrabold text-[#0b3c5d] mb-4">Project Gallery</h2>
            {galleryImages.length > 0 ? (
                <div>
                    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                        {galleryImages.slice(0, 6).map((image) => (
                            <figure class="overflow-hidden rounded-3xl border border-gray-200 bg-gray-50 aspect-video cursor-zoom-in hover:scale-[1.02] transition">
                                <img src={image} alt={service.title} class="js-zoom-trigger h-full w-full object-cover" />
                            </figure>
                        ))}
                    </div>
                    {galleryImages.length > 6 && (
                        <div class="mt-8 text-center">
                            <button id="open-gallery-modal" class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-[#0b3c5d] bg-white px-6 py-3 text-sm font-bold text-[#0b3c5d] hover:bg-[#0b3c5d] hover:text-white transition">
                                View All Photos (+{galleryImages.length - 6})
                            </button>
                        </div>
                    )}
                </div>
            ) : <p class="text-gray-500">Gallery coming soon</p>}
        </section>
    </main>

    <div id="gallery-modal" class="fixed inset-0 z-40 hidden items-center justify-center bg-black/70 p-4 backdrop-blur-sm">
        <div class="relative w-full max-w-5xl rounded-3xl bg-white p-6 md:p-8 shadow-2xl flex flex-col max-h-[90vh]">
            <div class="flex items-center justify-between border-b pb-4 mb-6">
                <h3 class="text-2xl font-extrabold text-[#0b3c5d]">{service.title} — Full Gallery</h3>
                <button id="close-gallery-modal" class="text-3xl text-gray-500 hover:text-black">✕</button>
            </div>
            <div class="overflow-y-auto pr-2 grid gap-4 grid-cols-2 md:grid-cols-3 flex-1 fn-custom-scrollbar">
                {galleryImages.map((image) => (
                    <figure class="aspect-video rounded-2xl overflow-hidden border border-gray-200 cursor-zoom-in">
                        <img src={image} class="js-zoom-trigger w-full h-full object-cover" />
                    </figure>
                ))}
            </div>
        </div>
    </div>

    <ZoomModal />
    <Footer />
</Layout>

<script>
    const setupIdPageScripts = () => {
        const zoomTriggers = document.querySelectorAll(".js-zoom-trigger");
        zoomTriggers.forEach((img) => {
            img.addEventListener("click", (e) => {
                e.stopPropagation();
                const target = img as HTMLImageElement;
                
                if (typeof (window as any).openZoom === 'function') {
                    (window as any).openZoom(target.src);
                } else {
                    console.error("Zoom function not available yet");
                }
            });
        });

        const modal = document.getElementById("gallery-modal");
        const openBtn = document.getElementById("open-gallery-modal");
        const closeBtn = document.getElementById("close-gallery-modal");

        if (openBtn && modal) {
            openBtn.onclick = () => {
                modal.classList.remove("hidden");
                modal.classList.add("flex");
                document.body.style.overflow = "hidden";
            };
        }

        if (closeBtn && modal) {
            const closeModal = () => {
                modal.classList.add("hidden");
                modal.classList.remove("flex");
                document.body.style.overflow = "";
            };
            closeBtn.onclick = closeModal;
            modal.onclick = (e) => { if (e.target === modal) closeModal(); };
        }
    };

    setupIdPageScripts();
    document.addEventListener("astro:page-load", setupIdPageScripts);
</script>

<style>
    .fn-custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .fn-custom-scrollbar::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 10px; }
    .fn-custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
</style>