---
// src/components/Footer.astro
import company from "../data/company.json";
import ArrowUp from "~icons/mdi/chevron-up";
---

<footer class="max-w-6xl mx-auto px-4 pb-12 pt-6">
    <div
        class="bg-gray-50 border border-gray-200/60 text-[11px] sm:text-xs text-gray-500 p-5 rounded-lg flex flex-row justify-between items-center gap-4 px-6"
    >
        <div class="flex items-center gap-3 min-w-0 shrink">
            <img
                src="/logo.png"
                alt={`${company.name} Logo`}
                class="h-6 w-auto opacity-70 grayscale hover:grayscale-0 transition-all shrink-0"
            />
            <p class="truncate">&copy; {new Date().getFullYear()} | {company.name}. All rights reserved.</p>
        </div>

        <div class="flex items-center gap-6 shrink-0">
            
            <div
                class="hidden sm:block text-right text-gray-400 leading-normal font-medium"
            >
                <span>{company.contact.phone} &nbsp;|&nbsp; {company.contact.email}</span><br />
                <span>{company.address.city}, {company.address.state}</span>
            </div>

            <div
                class="flex flex-col items-center justify-center text-sm text-gray-500 gap-0.5 shrink-0"
            >
                <button
                    onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
                    class="flex flex-col items-center hover:text-[#328cc1] transition-colors focus:outline-none group text-center"
                    aria-label="Back to top"
                >
                    <ArrowUp
                        class="w-7 h-7 transition-transform group-hover:-translate-y-0.5"
                    />
                    <span
                        class="text-[11px] font-bold uppercase tracking-wider -mt-1"
                        >Top</span
                    >
                </button>
            </div>

        </div>
    </div>
</footer>