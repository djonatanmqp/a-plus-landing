---
// src/components/TestimonialCard.astro
import CalendarIcon from "~icons/mdi/calendar-blank";
import MapMarkerIcon from "~icons/mdi/map-marker";
import { supabase } from "../lib/supabase.js";

const props = Astro.props || {};
const data = props.data || {};

const rawBefore = data.beforeImage || data.before_image || "";
const rawAfter = data.afterImage || data.after_image || "";

// Função auxiliar para obter a URL pública correta do Supabase Storage
const getStorageUrl = (path: string, fallbackText: string) => {
    if (!path) return `https://placehold.co/600x400?text=${fallbackText}`;
    if (path.startsWith("http") || path.startsWith("/")) return path;
    
    const { data: storageData } = supabase.storage.from("testimonials").getPublicUrl(path);
    return storageData?.publicUrl || `https://placehold.co/600x400?text=${fallbackText}`;
};

const beforePath = getStorageUrl(rawBefore, "Before");
const afterPath = getStorageUrl(rawAfter, "After");

const dateDisplay = data.date
    ? new Date(data.date).toLocaleString("en-US", {
          month: "long",
          year: "numeric",
      })
    : null;

const serviceType = data.serviceType || data.service || "";
const clientName = data.clientName || data.name || "";
const cityName = data.city || data.location || "";
const stateName = data.state || "";
---

<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex flex-col h-full">
    <div class="flex gap-3 mb-4">
        <div class="w-1/2">
            <p class="text-[9px] uppercase font-bold text-gray-400 mb-1 tracking-wider">Before</p>
            <img src={beforePath} alt="Before" class="w-full h-32 object-cover rounded shadow-sm border border-gray-100" />
        </div>
        <div class="w-1/2">
            <p class="text-[9px] uppercase font-bold text-gray-400 mb-1 tracking-wider">After</p>
            <img src={afterPath} alt="After" class="w-full h-32 object-cover rounded shadow-sm border border-gray-100" />
        </div>
    </div>

    <span class="text-[#328cc1] font-bold text-[10px] uppercase tracking-widest">
        {serviceType}
    </span>

    <div class="flex items-center gap-4 mt-1">
        {dateDisplay && (
            <span class="flex items-center gap-1 text-[10px] uppercase tracking-widest text-gray-400">
                <CalendarIcon class="w-3.5 h-3.5 text-gray-400" />
                {dateDisplay}
            </span>
        )}

        {cityName && (
            <span class="flex items-center gap-1 text-[10px] uppercase tracking-widest text-gray-400">
                <MapMarkerIcon class="w-3.5 h-3.5 text-gray-400" />
                {cityName}{stateName ? `, ${stateName}` : ''}
            </span>
        )}
    </div>

    <h3 class="font-bold text-lg mt-2 text-[#0b3c5d] leading-tight">
        {clientName}
    </h3>

    <div class="text-gray-600 mt-3 text-sm leading-relaxed grow italic">
        <slot />
    </div>
</div>