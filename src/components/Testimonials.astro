---
// src/components/Testimonials.astro
import TestimonialCard from "./TestimonialCard.astro";
import { getTestimonialsData } from "../lib/firebase-admin.ts";

import CloseIcon from "~icons/mdi/close";
import CalendarIcon from "~icons/mdi/calendar-blank";
import MapMarkerIcon from "~icons/mdi/map-marker";

// 🚀 BUSCA DIRETA DO FIRESTORE
const testimonialsList = await getTestimonialsData();

const testimonialsJson = JSON.stringify(testimonialsList);
const testimonialsScript = `
const testimonials = ${testimonialsJson};
const grid = document.getElementById("testimonials-grid");
const modal = document.getElementById("testimonial-modal");

if (grid && modal) {
    const closeModalButton = document.getElementById("testimonial-modal-close");
    const serviceEl = document.getElementById("testimonial-modal-service");
    const clientEl = document.getElementById("testimonial-modal-client");
    const dateEl = document.getElementById("testimonial-modal-date");
    const locEl = document.getElementById("testimonial-modal-location");
    const bodyEl = document.getElementById("testimonial-modal-body");
    const beforeImg = document.getElementById("testimonial-modal-before");
    const afterImg = document.getElementById("testimonial-modal-after");

    function openModal(t) {
        if (!t) return;
        serviceEl.textContent = t.serviceType || "";
        clientEl.textContent = t.clientName || "";
        dateEl.querySelector('span').textContent = t.date ? new Date(t.date).toLocaleString("en-US", { month: "long", year: "numeric" }) : "";
        locEl.querySelector('span').textContent = t.city && t.state ? t.city + ", " + t.state : "";
        bodyEl.textContent = t.message || "";
        
        beforeImg.src = t.beforeImage.startsWith('/') ? t.beforeImage : '/' + t.beforeImage;
        afterImg.src = t.afterImage.startsWith('/') ? t.afterImage : '/' + t.afterImage;
        
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
    }

    function closeModal() {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        document.body.style.overflow = "";
    }

    grid.addEventListener("click", (event) => {
        const card = event.target.closest("[data-testimonial-id]");
        if (!card) return;
        openModal(testimonials.find(t => t.id === card.getAttribute("data-testimonial-id")));
    });

    closeModalButton.addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => { if (e.target === modal) closeModal(); });
}
`;
---

<section id="testimonials" class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-extrabold text-[#0b3c5d] mb-8 text-center md:text-left">
        What Our Clients Say
    </h2>

    {testimonialsList.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" id="testimonials-grid">
            {testimonialsList.map((t: any) => (
                <article
                    class="testimonial-card cursor-pointer rounded-3xl border border-slate-200 bg-white p-0 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
                    data-testimonial-id={t.id}
                >
                    <TestimonialCard data={t}>{t.message}</TestimonialCard>
                </article>
            ))}
        </div>
    ) : (
        <div class="text-center py-16 border-2 border-dashed border-slate-200 rounded-3xl bg-slate-50">
            <p class="text-slate-500 font-medium">Customer testimonials coming soon.</p>
            <p class="text-sm text-slate-400">We are currently gathering feedback from our latest projects.</p>
        </div>
    )}
</section>

<div id="testimonial-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/70 p-4">
    <div class="relative w-full max-w-4xl overflow-hidden rounded-[2rem] bg-white px-6 py-8 shadow-2xl sm:px-8">
        <button id="testimonial-modal-close" class="absolute right-4 top-4 rounded-full bg-slate-100 p-2 text-slate-600 hover:bg-slate-200 transition-colors" aria-label="Close modal">
            <CloseIcon class="w-5 h-5" />
        </button>
        <div class="grid gap-6 lg:grid-cols-[1fr_1.3fr]">
            <div class="space-y-2">
                <div class="text-slate-500 text-xs uppercase tracking-[0.3em]">Service</div>
                <div id="testimonial-modal-service" class="text-xl font-bold text-[#0b3c5d]"></div>
                <div id="testimonial-modal-client" class="text-sm uppercase tracking-[0.25em] text-[#328cc1] mb-4"></div>
                <div class="flex flex-col gap-2">
                    <div id="testimonial-modal-date" class="flex items-center gap-2 text-sm text-slate-500">
                        <CalendarIcon class="w-4 h-4 text-slate-400" />
                        <span></span>
                    </div>
                    <div id="testimonial-modal-location" class="flex items-center gap-2 text-sm text-slate-500">
                        <MapMarkerIcon class="w-4 h-4 text-slate-400" />
                        <span></span>
                    </div>
                </div>
                <div id="testimonial-modal-body" class="text-slate-700 text-sm leading-relaxed mt-4"></div>
            </div>
            <div class="grid gap-4">
                <img id="testimonial-modal-before" src="" alt="Before" class="w-full h-64 object-cover rounded-3xl border border-slate-200" />
                <img id="testimonial-modal-after" src="" alt="After" class="w-full h-64 object-cover rounded-3xl border border-slate-200" />
            </div>
        </div>
    </div>
</div>

<script type="module" set:html={testimonialsScript} />