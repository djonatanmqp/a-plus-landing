---
// src/components/Hero.astro
import { supabase } from "../lib/supabase.js";

// Função otimizada para buscar e redimensionar a imagem do banner (largura 1200px para o Hero)
const getHeroImageUrl = (service: any) => {
    const path = service.cover_image || service.hero_image || '';
    if (!path) return '';
    if (path.startsWith('http')) {
        if (path.includes('supabase.co/storage')) {
            const separator = path.includes('?') ? '&' : '?';
            return `${path}${separator}width=1200&quality=85`;
        }
        return path;
    }
    const { data } = supabase.storage.from('services').getPublicUrl(path, {
        transform: {
            width: 1200,
            quality: 85,
        }
    });
    return data?.publicUrl || '';
};

const { data: rawServicesData } = await supabase
  .from("services")
  .select("*")
  .order("display_order", { ascending: true });

const servicesCarousel = Array.isArray(rawServicesData) ? rawServicesData.map((service: any) => {
    const image = getHeroImageUrl(service);

    return {
        title: service.title || "",
        subtitle: service.subtitle || service.short_description || "",
        shortDescription: service.short_description || "",
        description: service.description || "",
        image,
        galleryId: service.id,
    };
}) : [];
---

<section class="block bg-white p-0 m-0 overflow-hidden select-none">
    <div
        class="max-w-6xl mx-auto px-0 sm:px-4 pb-6 relative group block overflow-visible"
    >
        <div
            id="carousel-wrapper"
            class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth rounded-none sm:rounded-lg shadow-xl aspect-video md:aspect-21/9 no-scrollbar"
        >
            {
                servicesCarousel.map((service: any, index: number) => (
                    <div
                        id={`slide-${index}`}
                        class="w-full h-full shrink-0 snap-start relative"
                    >
                        <img
                            src={service.image}
                            alt={service.title}
                            class="w-full h-full object-cover"
                            loading={index === 0 ? "eager" : "lazy"}
                            {...(index === 0 ? { fetchpriority: "high" } : {})}
                            width="1200"
                            height="514"
                            onerror={`this.onerror=null; this.src='https://placehold.co/1200x600?text=${encodeURIComponent(service.title)}';`}
                        />

                        <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/30 to-transparent" />

                        <div class="absolute bottom-6 left-6 right-6 md:left-12 md:bottom-10 text-white max-w-lg z-10">
                            <span class="text-[#d9b310] font-bold text-xs uppercase tracking-widest bg-black/40 px-2 py-1 rounded">
                                Our Services
                            </span>
                            <h2 class="text-xl sm:text-3xl font-extrabold mt-2 tracking-tight">
                                {service.title}
                            </h2>
                            <p class="text-xs sm:text-sm text-gray-200 font-bold mt-1 mb-4 hidden sm:block">
                                {service.subtitle}
                            </p>
                            <a
                                href={`/services/${service.galleryId}`}
                                class="bg-[#328cc1] hover:bg-[#0b3c5d] text-white font-bold py-2.5 px-5 sm:py-3 sm:px-6 rounded-md shadow-lg transition-all inline-block text-xs uppercase tracking-wider border border-white/20"
                            >
                                View {service.title} Gallery
                            </a>
                        </div>
                    </div>
                ))
            }
        </div>

        <button
            id="prev-btn"
            class="absolute left-8 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-[#328cc1] text-white p-2 rounded-full hidden md:block opacity-0 group-hover:opacity-100 transition-opacity z-10"
            aria-label="Previous slide"
            >&#9664;</button
        >
        <button
            id="next-btn"
            class="absolute right-8 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-[#328cc1] text-white p-2 rounded-full hidden md:block opacity-0 group-hover:opacity-100 transition-opacity z-10"
            aria-label="Next slide"
            >&#9654;</button
        >
    </div>
</section>

<style>
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<script>
    const wrapper = document.getElementById("carousel-wrapper");
    const prevBtn = document.getElementById("prev-btn");
    const nextBtn = document.getElementById("next-btn");

    if (wrapper && prevBtn && nextBtn) {
        const autoplayInterval = 5000;

        const nextSlide = () => {
            const maxScrollLeft = wrapper.scrollWidth - wrapper.clientWidth;
            if (wrapper.scrollLeft >= maxScrollLeft - 10) {
                wrapper.scrollLeft = 0;
            } else {
                wrapper.scrollLeft += wrapper.clientWidth;
            }
        };

        const prevSlide = () => {
            if (wrapper.scrollLeft <= 0) {
                wrapper.scrollLeft = wrapper.scrollWidth - wrapper.clientWidth;
            } else {
                wrapper.scrollLeft -= wrapper.clientWidth;
            }
        };

        nextBtn.addEventListener("click", () => {
            nextSlide();
            resetAutoplay();
        });
        prevBtn.addEventListener("click", () => {
            prevSlide();
            resetAutoplay();
        });

        let autoPlayTimer = setInterval(nextSlide, autoplayInterval);

        const resetAutoplay = () => {
            clearInterval(autoPlayTimer);
            autoPlayTimer = setInterval(nextSlide, autoplayInterval);
        };

        wrapper.addEventListener("mouseenter", () =>
            clearInterval(autoPlayTimer),
        );
        wrapper.addEventListener("mouseleave", () => {
            autoPlayTimer = setInterval(nextSlide, autoplayInterval);
        });
    }

    const toggleBtn = document.getElementById("menu-toggle");
    const closeBtn = document.getElementById("menu-close");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuContent = mobileMenu?.querySelector(".menu-content");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    if (toggleBtn && mobileMenu && menuContent && closeBtn) {
        const openMenu = () => {
            toggleBtn.classList.add("menu-active");
            mobileMenu.classList.remove("pointer-events-none", "opacity-0");
            mobileMenu.classList.add("opacity-100");
            menuContent.classList.remove("translate-x-full");
            menuContent.classList.add("translate-x-0");
        };

        const closeMenu = () => {
            toggleBtn.classList.remove("menu-active");
            mobileMenu.classList.add("pointer-events-none", "opacity-0");
            mobileMenu.classList.remove("opacity-100");
            menuContent.classList.remove("translate-x-0");
            menuContent.classList.add("translate-x-full");
        };

        toggleBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            toggleBtn.classList.contains("menu-active")
                ? closeMenu()
                : openMenu();
        });

        closeBtn.addEventListener("click", closeMenu);
        mobileMenu.addEventListener("click", (e) => {
            if (e.target === mobileMenu) closeMenu();
        });

        mobileLinks.forEach((link) =>
            link.addEventListener("click", closeMenu),
        );
    }
</script>