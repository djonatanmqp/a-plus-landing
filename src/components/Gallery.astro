---
// Dados estruturados que mapeiam as pastas locais do cliente
const servicesData = [
    {
        id: "driveways",
        title: "Driveway Pavers",
        description:
            "Professional paver installation for driveways, patios, and walkways in Orlando. Built to handle heavy vehicles and enhance curb appeal.",
        coverImage: [
            "/services/driveways/cover.jpg",
            "/services/driveways/cover.webp",
            "/services/driveways/cover.png",
        ],
        images: [
            ["/services/driveways/projeto1.jpg", "/services/driveways/projeto1.webp", "/services/driveways/projeto1.png"],
            ["/services/driveways/projeto2.jpg", "/services/driveways/projeto2.webp", "/services/driveways/projeto2.png"],
            ["/services/driveways/projeto3.jpg", "/services/driveways/projeto3.webp", "/services/driveways/projeto3.png"],
        ],
    },
    {
        id: "patios",
        title: "Patio & Walkways",
        description:
            "Custom designed patios and walkways that turn your backyard into a luxury outdoor living space, perfectly fitted for Florida weather.",
        coverImage: [
            "/services/patios/cover.jpg",
            "/services/patios/cover.webp",
            "/services/patios/cover.png",
        ],
        images: [
            ["/services/patios/foto1.jpg", "/services/patios/foto1.webp", "/services/patios/foto1.png"],
            ["/services/patios/foto2.jpg", "/services/patios/foto2.webp", "/services/patios/foto2.png"],
        ],
    },
    {
        id: "lawn",
        title: "Artificial Turf & Sod",
        description:
            "Expert turf and sod installation, offering a green, thriving lawn in Orlando. Low maintenance, high durability solutions.",
        coverImage: [
            "/services/lawn/cover.webp",
            "/services/lawn/cover.jpg",
            "/services/lawn/cover.png",
        ],
        images: [
            ["/services/lawn/antes.webp", "/services/lawn/antes.jpg", "/services/lawn/antes.png"],
            ["/services/lawn/depois.webp", "/services/lawn/depois.jpg", "/services/lawn/depois.png"],
        ],
    },
];
---

<section class="max-w-6xl mx-auto px-4 py-6">
    <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
        <h2
            class="text-3xl font-extrabold text-[#0b3c5d] mb-4 relative inline-block after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-12 after:h-1 after:bg-[#328cc1] pb-2"
        >
            Photo Gallery
        </h2>
        <p
            class="text-xs text-gray-500 mb-8 font-semibold uppercase tracking-wider"
        >
            Click on a service to view full project gallery
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
            {
                servicesData.map((service) => (
                    <div
                        id={`gallery-${service.id}`}
                        class="gallery-trigger group cursor-pointer bg-gray-50 rounded-lg overflow-hidden border border-gray-200 shadow-sm hover:shadow-md transition-all duration-300"
                        data-service={JSON.stringify(service)}
                    >
                        <div class="relative overflow-hidden aspect-video">
                            <img
                                src={service.coverImage[0]}
                                alt={service.title}
                                data-image-variants={JSON.stringify(service.coverImage)}
                                data-fallback-label={`${service.title} Cover`}
                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                onerror="this.onerror=null; tryNextImageVariant(this);"
                            />
                            <div class="absolute inset-0 bg-[#0b3c5d]/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                <span class="bg-white text-[#0b3c5d] text-xs font-bold py-2 px-4 rounded-full shadow-md">
                                    View Gallery 🔍
                                </span>
                            </div>
                        </div>
                        <div class="p-4 bg-white border-t border-gray-100">
                            <h3 class="font-bold text-lg text-[#0b3c5d] group-hover:text-[#328cc1] transition-colors">
                                {service.title}
                            </h3>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<dialog
    id="gallery-modal"
    class="fixed inset-0 m-auto rounded-xl p-0 w-11/12 max-w-2xl overflow-hidden shadow-2xl border border-gray-100/50 outline-none bg-white opacity-0 transition-all duration-300 scale-95"
>
    <div class="flex flex-col bg-white max-h-[85vh]">
        <div
            class="flex justify-between items-center bg-[#0b3c5d] text-white p-5 sm:px-6"
        >
            <h3 id="modal-title" class="font-extrabold text-xl tracking-tight">
                Service Details
            </h3>
            <button
                id="close-modal"
                class="text-white/80 hover:text-[#d9b310] text-3xl font-light transition-colors focus:outline-none leading-none pb-1"
                aria-label="Close modal">&times;</button
            >
        </div>

        <div class="p-6 overflow-y-auto space-y-6 no-scrollbar">
            <p
                id="modal-description"
                class="text-gray-600 leading-relaxed text-sm sm:text-base"
            >
            </p>

            <div>
                <h4
                    class="font-bold text-xs uppercase tracking-wider text-gray-400 mb-4"
                >
                    Project Portfolio
                </h4>
                <div
                    id="modal-images-grid"
                    class="grid grid-cols-2 sm:grid-cols-3 gap-3"
                >
                </div>
            </div>
        </div>
    </div>
</dialog>

<style>
    dialog::backdrop {
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    dialog.modal-open {
        opacity: 1;
        transform: scale(1);
    }
    dialog.modal-open::backdrop {
        opacity: 1;
    }
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<script>
    const tryNextImageVariant = (img: HTMLImageElement) => {
        const variants = JSON.parse(img.dataset.imageVariants || "[]");
        const currentIndex = Number(img.dataset.variantIndex || 0);

        if (currentIndex < variants.length - 1) {
            img.dataset.variantIndex = String(currentIndex + 1);
            img.src = variants[currentIndex + 1];
            return;
        }

        const fallbackLabel = img.dataset.fallbackLabel || "Image";
        img.src = `https://placehold.co/600x400?text=${encodeURIComponent(fallbackLabel)}`;
    };

    const triggers = document.querySelectorAll(".gallery-trigger");
    const modal = document.getElementById("gallery-modal") as HTMLDialogElement;
    const modalTitle = document.getElementById("modal-title");
    const modalDescription = document.getElementById("modal-description");
    const modalImagesGrid = document.getElementById("modal-images-grid");
    const closeModal = document.getElementById("close-modal");

    if (
        modal &&
        modalTitle &&
        modalDescription &&
        modalImagesGrid &&
        closeModal
    ) {
        const openModalEvent = (serviceData: any) => {
            modalTitle.textContent = serviceData.title;
            modalDescription.textContent = serviceData.description;
            modalImagesGrid.innerHTML = "";

            const projectImages =
                serviceData.images && serviceData.images.length > 0
                    ? serviceData.images
                    : [
                          [`https://placehold.co/600x400?text=${encodeURIComponent(serviceData.title)}+Photos+Coming+Soon`],
                      ];

            projectImages.forEach((imgUrl: string | string[], index: number) => {
                const imgWrapper = document.createElement("div");
                imgWrapper.className =
                    "rounded-lg overflow-hidden border border-gray-100 aspect-video shadow-sm bg-gray-50";

                const variants = Array.isArray(imgUrl) ? imgUrl : [imgUrl];
                const img = document.createElement("img");
                img.src = variants[0];
                img.alt = `${serviceData.title} view ${index + 1}`;
                img.dataset.imageVariants = JSON.stringify(variants);
                img.dataset.fallbackLabel = `${serviceData.title} Image ${index + 1}`;
                img.className =
                    "w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-zoom-in";

                img.onerror = () => {
                    tryNextImageVariant(img);
                };

                imgWrapper.appendChild(img);
                modalImagesGrid.appendChild(imgWrapper);
            });

            modal.showModal();
            setTimeout(() => {
                modal.classList.add("modal-open");
            }, 10);
        };

        const closeModalEvent = () => {
            modal.classList.remove("modal-open");
            setTimeout(() => {
                modal.close();
            }, 300);
        };

        triggers.forEach((trigger) => {
            trigger.addEventListener("click", () => {
                const serviceData = JSON.parse(
                    trigger.getAttribute("data-service") || "{}",
                );
                openModalEvent(serviceData);
            });
        });

        closeModal.addEventListener("click", closeModalEvent);
        modal.addEventListener("click", (e) => {
            if (e.target === modal) closeModalEvent();
        });
        modal.addEventListener("cancel", (e) => {
            e.preventDefault();
            closeModalEvent();
        });
    }
</script>
