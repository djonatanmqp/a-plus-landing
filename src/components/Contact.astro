---
// src/components/Contact.astro
---

<section id="contact" class="max-w-6xl mx-auto px-4 py-6">
    <div
        class="bg-white rounded-xl p-8 shadow-sm border border-gray-100 relative overflow-hidden"
    >
        <div
            class="absolute bottom-0 right-0 w-32 h-32 opacity-[0.03] pointer-events-none select-none"
        >
            <img
                src="/paver-pattern.png"
                alt=""
                class="w-full h-full object-cover"
            />
        </div>

        <h2 class="text-2xl font-extrabold text-[#0b3c5d] mb-2">Contact Us</h2>
        <p
            class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-6"
        >
            Contact us for a free estimate
        </p>

        <div
            class="space-y-3 text-sm sm:text-base font-semibold text-[#328cc1]"
        >
            <p class="flex items-center gap-2">
                <span class="text-gray-400 select-none">📞</span>
                <a
                    href="tel:4071234567"
                    class="hover:underline text-[#0b3c5d] hover:text-[#328cc1] transition-colors"
                    >(407) 123-4567</a
                >
            </p>
            <p class="flex items-center gap-2">
                <span class="text-gray-400 select-none">✉️</span>
                <a
                    href="mailto:info@apluspaversgrass.com"
                    class="hover:underline text-[#0b3c5d] hover:text-[#328cc1] transition-colors"
                    >info@apluspaversgrass.com</a
                >
            </p>
            <p class="flex items-center gap-2">
                <span class="text-gray-400 select-none">📸</span>
                <a
                    href="#"
                    class="hover:underline text-[#0b3c5d] hover:text-[#328cc1] transition-colors"
                    >Instagram @apluspaversgrass</a
                >
            </p>
        </div>

        <div
            class="flex justify-end gap-5 mt-6 pt-4 border-t border-gray-100 text-gray-400 font-medium text-sm"
        >
            <a
                href="#"
                class="hover:text-[#0b3c5d] transition-colors flex items-center gap-1"
                >🌐 Facebook</a
            >
            <a
                href="#"
                class="hover:text-[#0b3c5d] transition-colors flex items-center gap-1"
                >📸 Instagram</a
            >
            <a
                href="#"
                class="hover:text-[#0b3c5d] transition-colors flex items-center gap-1"
                >🎵 TikTok</a
            >
        </div>
    </div>
</section>
