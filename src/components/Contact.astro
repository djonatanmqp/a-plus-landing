---
// src/components/Contact.astro
import Phone from "~icons/mdi/phone";
import Video from "~icons/mdi/video";
import Email from "~icons/mdi/email";
import MapMarker from "~icons/mdi/map-marker";
import Facebook from "~icons/simple-icons/facebook";
import Instagram from "~icons/simple-icons/instagram";
import Tiktok from "~icons/simple-icons/tiktok";
import GoogleIcon from "~icons/simple-icons/google";

import { getCompanyData } from "../lib/firebase-admin.ts";

const company = await getCompanyData();
---

<section id="contact" class="max-w-6xl mx-auto px-4 py-2">
    <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100 grid md:grid-cols-2 gap-10">
        
        <div>
            <h2 class="text-2xl font-extrabold text-[#0b3c5d] mb-2">
                Contact Us
            </h2>
            <p class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-8">
                Contact us for a free estimate
            </p>

            <div class="space-y-4 text-sm sm:text-base font-semibold text-[#328cc1]">
                <a
                    href={company.links?.googleReview ? company.links.googleReview.replace('writereview?placeid=', '?q=') : '#'} 
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-start gap-3 text-[#0b3c5d] hover:text-[#328cc1] transition-colors"
                >
                    <MapMarker class="w-5 h-5 text-gray-400 shrink-0 mt-0.5" />
                    <span>{company.address?.full}</span>
                </a>

                <a
                    href={`tel:${company.contact?.phoneRaw}`}
                    class="flex items-center gap-3 text-[#0b3c5d] hover:text-[#328cc1] transition-colors"
                >
                    <Phone class="w-5 h-5 text-gray-400" /> {company.contact?.phone}
                </a>

                <a
                    href={`facetime:${company.contact?.facetime}`}
                    class="flex items-center gap-3 text-[#0b3c5d] hover:text-[#328cc1] transition-colors"
                >
                    <Video class="w-5 h-5 text-gray-400" /> FaceTime
                </a>

                <a
                    href={`mailto:${company.contact?.email}`}
                    class="flex items-center gap-3 text-[#0b3c5d] hover:text-[#328cc1] transition-colors"
                >
                    <Email class="w-5 h-5 text-gray-400" /> {company.contact?.email}
                </a>
            </div>

            <div class="flex gap-5 mt-8 pt-6 border-t border-gray-100">
                <a href={company.links?.googleReview} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-[#4285F4] transition-colors" aria-label="Google Reviews">
                    <GoogleIcon class="w-8 h-8" />
                </a>
                <a href={company.links?.facebook} class="text-gray-400 hover:text-[#1877F2] transition-colors" aria-label="Facebook">
                    <Facebook class="w-8 h-8" />
                </a>
                <a href={company.links?.instagram} class="text-gray-400 hover:text-[#E1306C] transition-colors" aria-label="Instagram">
                    <Instagram class="w-8 h-8" />
                </a>
                <a href={company.links?.tiktok} class="text-gray-400 hover:text-[#000000] transition-colors" aria-label="TikTok">
                    <Tiktok class="w-8 h-8" />
                </a>
            </div>
        </div>

        <div class="w-full h-64 md:h-auto min-h-[250px] rounded-xl overflow-hidden border border-gray-100 shadow-inner">
            <iframe
                width="100%"
                height="100%"
                style="border:0"
                loading="lazy"
                allowfullscreen
                src={company.links?.googleMapsEmbed}
                referrerpolicy="no-referrer-when-downgrade"
            >
            </iframe>
        </div>
    </div>
</section>