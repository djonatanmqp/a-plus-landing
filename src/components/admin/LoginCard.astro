---
// src/components/admin/LoginCard.astro
---

<section
  class="mx-auto mt-6 max-w-sm rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"
>
  <h2 class="text-base font-bold text-[#0b3c5d] mb-1 text-center">
    Admin Access
  </h2>
  <p class="text-xs text-slate-500 mb-4 text-center">
    Sign in with your email and password or Google account.
  </p>

  <form
    id="login-form"
    method="POST"
    action="/admin/api/login"
    class="grid gap-3"
  >
    <label class="grid gap-1 text-xs font-semibold text-slate-700">
      Email
      <input
        type="email"
        name="username"
        required
        placeholder="admin@apluspaversgrass.com"
        class="rounded-lg border border-slate-300 px-3 py-2 text-xs font-normal focus:border-[#0b3c5d] focus:outline-none"
      />
    </label>

    <label class="grid gap-1 text-xs font-semibold text-slate-700">
      <div class="flex items-center justify-between">
        <span>Password</span>
        <a
          href="#forgot"
          id="forgot-password-link"
          class="text-[11px] font-normal text-[#0b3c5d] hover:underline"
          >Forgot password?</a
        >
      </div>
      <input
        type="password"
        name="password"
        required
        placeholder="••••••••"
        class="rounded-lg border border-slate-300 px-3 py-2 text-xs font-normal focus:border-[#0b3c5d] focus:outline-none"
      />
    </label>

    <button
      type="submit"
      class="w-full rounded-full bg-[#0b3c5d] py-2 text-xs font-semibold text-white transition hover:bg-[#2570a2]"
    >
      Sign In
    </button>
  </form>

  <div class="relative my-4 flex items-center justify-center">
    <span class="absolute bg-white px-2 text-[11px] text-slate-400">or</span>
    <div class="w-full border-t border-slate-200"></div>
  </div>

  <button
    type="button"
    id="google-login-btn"
    class="flex w-full items-center justify-center gap-2 rounded-full border border-slate-300 bg-white py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50"
  >
    <svg class="h-4 w-4" viewBox="0 0 24 24">
      <path
        fill="#4285F4"
        d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"
      ></path>
      <path
        fill="#34A853"
        d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.13 0-5.78-2.11-6.73-4.96H1.18v3.15C3.15 21.32 7.23 24 12 24z"
      ></path>
      <path
        fill="#FBBC05"
        d="M5.27 14.24c-.25-.72-.38-1.49-.38-2.24s.13-1.52.38-2.24V6.6H1.18C.43 8.13 0 9.87 0 12s.43 3.87 1.18 5.4l4.09-3.16z"
      ></path>
      <path
        fill="#EA4335"
        d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.23 0 3.15 2.68 1.18 6.6l4.09 3.15c.95-2.85 3.6-4.96 6.73-4.96z"
      ></path>
    </svg>
    <span>Sign in with Google</span>
  </button>
</section>

<script>
  import { createClient } from "@supabase/supabase-js";

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  );

  document
    .getElementById("forgot-password-link")
    ?.addEventListener("click", async (e) => {
      e.preventDefault();
      const email = prompt(
        "Enter your admin email to receive a password reset link:",
      );
      if (!email) return;

      const { error } = await supabase.auth.resetPasswordForEmail(email, {
        redirectTo: `${window.location.origin}/admin`,
      });

      if (error) alert("Error: " + error.message);
      else alert("Password reset instructions sent to your email!");
    });

  const googleBtn = document.getElementById("google-login-btn");
  if (googleBtn) {
    googleBtn.addEventListener("click", async (e) => {
      try {
        // Initiate OAuth from the browser so the PKCE code_verifier is saved to browser storage
        const { data, error } = await supabase.auth.signInWithOAuth({
          provider: 'google',
          options: {
            redirectTo: `${window.location.origin}/admin`,
          },
        });

        if (error || !data?.url) {
          console.error('Supabase signInWithOAuth error:', error);
          alert('Error: Could not initialize Google login');
          return;
        }

        // Redirect the browser to the provider URL
        window.location.href = data.url;
      } catch (err) {
        console.error(err);
        alert('Error: Could not initialize Google login');
      }
    });
  }
</script>
