---
// src/components/admin/ServicesTab.astro
import ContentSaveIcon from "~icons/mdi/content-save";
import PencilIcon from "~icons/mdi/pencil";
import PlusIcon from "~icons/mdi/plus";
import DeleteIcon from "~icons/mdi/delete";
import CloudUploadIcon from "~icons/mdi/cloud-upload";

const { services = [] } = Astro.props;
const selectedId = Astro.url.searchParams.get("service_id") || "";
const selectedService = services.find((s: any) => s.id === selectedId) || null;

const highlights = Array.isArray(selectedService?.highlights)
  ? selectedService.highlights
  : [];
---

<section
  class="rounded-2xl border border-slate-200 bg-white p-3 sm:p-5 shadow-sm"
>
  <div
    class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-4 border-b pb-3"
  >
    <div>
      <h2 class="text-base sm:text-lg font-semibold text-[#0b3c5d]">
        Services Management
      </h2>
      <p class="text-xs text-slate-500">
        Select a service to edit its details, images, and highlights.
      </p>
    </div>

    {/* Seletor de Serviço (Dropdown) com opção padrão */}
    <div class="flex items-center gap-2 w-full sm:w-auto">
      <select
        id="service-selector"
        class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs bg-white text-slate-800 font-medium focus:outline-none flex-1 sm:w-64"
        onchange="window.location.href = `/admin?tab=services&service_id=${this.value}`"
      >
        <option value="" disabled selected={!selectedId}
          >Select a service...</option
        >
        {
          services.length === 0 ? (
            <option value="" disabled>
              No services available
            </option>
          ) : (
            services.map((s: any) => (
              <option value={s.id} selected={s.id === selectedService?.id}>
                {s.title}
              </option>
            ))
          )
        }
      </select>

      <button
        type="button"
        id="open-new-service-modal"
        class="flex items-center gap-1 rounded-full bg-[#0b3c5d] px-3 py-1.5 text-xs font-semibold text-white hover:bg-[#2570a2] whitespace-nowrap"
      >
        <PlusIcon class="w-4 h-4" /> New Service
      </button>
    </div>
  </div>

  {/* Formulário para Adicionar Novo Serviço */}
  <form
    id="new-service-form"
    method="POST"
    action="/admin/api/service"
    enctype="multipart/form-data"
    class="hidden mb-6 rounded-xl border border-slate-300 bg-slate-50 p-4 grid gap-4 shadow-inner"
  >
    <input type="hidden" name="action" value="create" />
    <div class="flex items-center justify-between border-b pb-2">
      <h3 class="text-xs font-bold text-[#0b3c5d] uppercase tracking-wider">
        Create New Service
      </h3>
      <button
        type="button"
        id="close-new-service"
        class="text-xs text-slate-500 hover:text-slate-800 font-bold"
        >✕ Cancel</button
      >
    </div>

    <div class="grid gap-3 sm:grid-cols-3">
      <label
        class="grid gap-1 text-xs font-semibold text-slate-700 sm:col-span-2"
      >
        Title *
        <input
          type="text"
          name="title"
          required
          placeholder="Service Title"
          class="rounded-lg border border-slate-300 px-3 py-2 text-xs bg-white focus:outline-none"
        />
      </label>
      <label class="grid gap-1 text-xs font-semibold text-slate-700">
        Display Order
        <input
          type="number"
          name="display_order"
          placeholder="0"
          value="0"
          class="rounded-lg border border-slate-300 px-3 py-2 text-xs bg-white focus:outline-none"
        />
      </label>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      <label class="grid gap-1 text-xs font-semibold text-slate-700">
        Subtitle
        <input
          type="text"
          name="subtitle"
          placeholder="Service Subtitle"
          class="rounded-lg border border-slate-300 px-3 py-2 text-xs bg-white focus:outline-none"
        />
      </label>
      <label class="grid gap-1 text-xs font-semibold text-slate-700">
        Short Description
        <input
          type="text"
          name="short_description"
          placeholder="Brief summary..."
          class="rounded-lg border border-slate-300 px-3 py-2 text-xs bg-white focus:outline-none"
        />
      </label>
    </div>

    <label class="grid gap-1 text-xs font-semibold text-slate-700">
      Full Description
      <textarea
        name="description"
        rows="3"
        placeholder="Detailed service description..."
        class="rounded-lg border border-slate-300 px-3 py-2 text-xs bg-white focus:outline-none"
      ></textarea>
    </label>

    <div class="grid gap-4 sm:grid-cols-2 border-t pt-3">
      <div class="grid gap-1.5">
        <span class="text-xs font-semibold text-slate-700">Cover Image</span>
        <div
          class="rounded-xl border border-dashed border-slate-300 p-2.5 text-center bg-white flex items-center justify-between gap-2"
        >
          <span class="file-name-display text-[11px] text-slate-500 truncate"
            >Upload cover image</span
          >
          <label
            class="rounded-full bg-[#0b3c5d] px-3 py-1 text-[11px] font-semibold text-white cursor-pointer hover:bg-[#2570a2] whitespace-nowrap shrink-0"
          >
            Browse <input
              type="file"
              name="cover_image_file"
              class="hidden file-input"
              accept="image/*"
            />
          </label>
        </div>
      </div>

      <div class="grid gap-1.5">
        <span class="text-xs font-semibold text-slate-700">Hero Image</span>
        <div
          class="rounded-xl border border-dashed border-slate-300 p-2.5 text-center bg-white flex items-center justify-between gap-2"
        >
          <span class="file-name-display text-[11px] text-slate-500 truncate"
            >Upload hero image</span
          >
          <label
            class="rounded-full bg-[#0b3c5d] px-3 py-1 text-[11px] font-semibold text-white cursor-pointer hover:bg-[#2570a2] whitespace-nowrap shrink-0"
          >
            Browse <input
              type="file"
              name="hero_image_file"
              class="hidden file-input"
              accept="image/*"
            />
          </label>
        </div>
      </div>
    </div>

    <div class="border-t pt-4">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-xs font-bold text-[#0b3c5d] uppercase tracking-wider">
          Service Highlights
        </h3>
      </div>

      <div class="flex gap-2 mb-3">
        <input
          type="text"
          id="new-highlight-input"
          placeholder="New highlight item..."
          class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs bg-white focus:outline-none flex-1"
        />
        <button
          type="button"
          id="add-new-highlight-btn"
          class="flex items-center gap-1 rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700 whitespace-nowrap"
        >
          <PlusIcon class="w-4 h-4" /> Add Highlight
        </button>
      </div>

      <div id="new-highlights-container" class="grid gap-2">
        <p id="no-highlights-text" class="text-xs text-slate-400 italic">
          No highlights added yet.
        </p>
      </div>
    </div>

    <div class="flex justify-end pt-2 border-t">
      <button
        type="submit"
        class="flex items-center gap-1.5 rounded-full bg-emerald-600 px-5 py-2 text-xs font-semibold text-white hover:bg-emerald-700"
      >
        <PlusIcon class="w-4 h-4" /> Save & Create Service
      </button>
    </div>
  </form>

  {/* Formulário de Edição do Serviço Selecionado */}
  {
    selectedService ? (
      <form
        method="POST"
        action="/admin/api/service"
        class="grid gap-5"
        enctype="multipart/form-data"
      >
        <input type="hidden" name="action" value="update" />
        <input type="hidden" name="id" value={selectedService.id} />

        <div class="grid gap-3 sm:grid-cols-3">
          <label class="grid gap-1 text-xs font-semibold text-slate-700 sm:col-span-2">
            Title
            <input
              type="text"
              name="title"
              value={selectedService.title || ""}
              required
              class="rounded-lg border border-slate-300 px-3 py-2 text-xs focus:outline-none"
            />
          </label>
          <label class="grid gap-1 text-xs font-semibold text-slate-700">
            Display Order
            <input
              type="number"
              name="display_order"
              value={selectedService.display_order ?? 0}
              class="rounded-lg border border-slate-300 px-3 py-2 text-xs focus:outline-none"
            />
          </label>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <label class="grid gap-1 text-xs font-semibold text-slate-700">
            Subtitle
            <input
              type="text"
              name="subtitle"
              value={selectedService.subtitle || ""}
              class="rounded-lg border border-slate-300 px-3 py-2 text-xs focus:outline-none"
            />
          </label>
          <label class="grid gap-1 text-xs font-semibold text-slate-700">
            Short Description
            <input
              type="text"
              name="short_description"
              value={selectedService.short_description || ""}
              class="rounded-lg border border-slate-300 px-3 py-2 text-xs focus:outline-none"
            />
          </label>
        </div>

        <label class="grid gap-1 text-xs font-semibold text-slate-700">
          Full Description
          <textarea
            name="description"
            rows="3"
            class="rounded-lg border border-slate-300 px-3 py-2 text-xs focus:outline-none"
          >
            {selectedService.description || ""}
          </textarea>
        </label>

        <div class="grid gap-4 sm:grid-cols-2 border-t pt-4">
          <div class="grid gap-1.5">
            <span class="text-xs font-semibold text-slate-700">
              Cover Image
            </span>
            <div class="rounded-xl border border-dashed border-slate-300 p-2.5 text-center bg-slate-50 flex items-center justify-between gap-2">
              <div class="flex items-center gap-2 text-left overflow-hidden">
                <CloudUploadIcon class="w-5 h-5 text-slate-400 shrink-0" />
                <span class="file-name-display text-[11px] text-slate-500 truncate">
                  {selectedService.cover_image ? `Current: ${selectedService.cover_image.split('/').pop()}` : 'Drag and drop or click to upload.'}
                </span>
              </div>
              <label class="rounded-full bg-[#0b3c5d] px-3 py-1 text-[11px] font-semibold text-white cursor-pointer hover:bg-[#2570a2] whitespace-nowrap shrink-0">
                Browse Images
                <input
                  type="file"
                  name="cover_image_file"
                  class="hidden file-input"
                  accept="image/*"
                />
              </label>
            </div>
          </div>

          <div class="grid gap-1.5">
            <span class="text-xs font-semibold text-slate-700">Hero Image</span>
            <div class="rounded-xl border border-dashed border-slate-300 p-2.5 text-center bg-slate-50 flex items-center justify-between gap-2">
              <div class="flex items-center gap-2 text-left overflow-hidden">
                <CloudUploadIcon class="w-5 h-5 text-slate-400 shrink-0" />
                <span class="file-name-display text-[11px] text-slate-500 truncate">
                  {selectedService.hero_image ? `Current: ${selectedService.hero_image.split('/').pop()}` : 'Drag and drop or click to upload.'}
                </span>
              </div>
              <label class="rounded-full bg-[#0b3c5d] px-3 py-1 text-[11px] font-semibold text-white cursor-pointer hover:bg-[#2570a2] whitespace-nowrap shrink-0">
                Browse Images
                <input
                  type="file"
                  name="hero_image_file"
                  class="hidden file-input"
                  accept="image/*"
                />
              </label>
            </div>
          </div>
        </div>

        {/* Seção de Highlights com Adição Dinâmica Local */}
        <div class="border-t pt-4">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-xs font-bold text-[#0b3c5d] uppercase tracking-wider">
              Service Highlights
            </h3>
          </div>

          <div class="flex gap-2 mb-3">
            <input
              type="text"
              id="edit-new-highlight-input"
              placeholder="New highlight item..."
              class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs bg-white focus:outline-none flex-1"
            />
            <button
              type="button"
              id="edit-add-highlight-btn"
              class="flex items-center gap-1 rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700 whitespace-nowrap"
            >
              <PlusIcon class="w-4 h-4" /> Add Highlight
            </button>
          </div>

          <div id="edit-highlights-container" class="grid gap-2">
            {highlights.length === 0 ? (
              <p
                id="edit-no-highlights-text"
                class="text-xs text-slate-400 italic"
              >
                No highlights added yet.
              </p>
            ) : (
              highlights.map((item: string) => (
                <div class="flex items-center gap-2 bg-slate-50 p-2 rounded-lg border border-slate-200 highlight-row">
                  <input
                    type="text"
                    name="highlights[]"
                    value={item}
                    class="rounded border border-slate-300 px-2 py-1 text-xs bg-white focus:outline-none flex-1"
                  />
                  <button
                    type="button"
                    class="flex items-center gap-1 rounded bg-red-600 px-2.5 py-1 text-xs text-white hover:bg-red-700 remove-highlight-btn"
                    title="Delete Highlight"
                  >
                    <DeleteIcon class="w-3.5 h-3.5" />
                  </button>
                </div>
              ))
            )}
          </div>
        </div>

        <div class="flex justify-end pt-3 border-t">
          <button
            type="submit"
            name="action"
            value="update"
            class="flex items-center gap-1.5 rounded-full bg-[#0b3c5d] px-5 py-2 text-xs font-semibold text-white hover:bg-[#2570a2]"
          >
            <ContentSaveIcon class="w-4 h-4" /> Save Service Changes
          </button>
        </div>
      </form>
    ) : (
      <p class="text-xs text-slate-500 italic py-8 text-center">
        No service selected. Choose a service from the dropdown above or click
        "New Service" to create one.
      </p>
    )
  }
</section>

<script>
  import { setupAdminImageCompression } from "../../scripts/admin-image-compression";

  const openNewBtn = document.getElementById("open-new-service-modal");
  const closeNewBtn = document.getElementById("close-new-service");
  const newForm = document.getElementById("new-service-form");

  if (openNewBtn && newForm && closeNewBtn) {
    openNewBtn.addEventListener("click", () => {
      newForm.classList.toggle("hidden");
    });
    closeNewBtn.addEventListener("click", () => {
      newForm.classList.add("hidden");
    });
  }

  // Função auxiliar para gerenciar adição/remoção de highlights dinamicamente na UI
  function setupHighlightManager(
    inputId: string,
    btnId: string,
    containerId: string,
    emptyTextId: string,
  ) {
    const addBtn = document.getElementById(btnId);
    const input = document.getElementById(inputId) as HTMLInputElement;
    const container = document.getElementById(containerId);
    const emptyText = document.getElementById(emptyTextId);

    if (addBtn && input && container) {
      addBtn.addEventListener("click", () => {
        const text = input.value.trim();
        if (!text) return;

        if (emptyText) {
          emptyText.remove();
        }

        const row = document.createElement("div");
        row.className =
          "flex items-center gap-2 bg-slate-50 p-2 rounded-lg border border-slate-200 highlight-row";

        const field = document.createElement("input");
        field.type = "text";
        field.name = "highlights[]";
        field.value = text;
        field.className =
          "rounded border border-slate-300 px-2 py-1 text-xs bg-white focus:outline-none flex-1";

        const deleteBtn = document.createElement("button");
        deleteBtn.type = "button";
        deleteBtn.className =
          "flex items-center gap-1 rounded bg-red-600 px-2.5 py-1 text-xs text-white hover:bg-red-700 remove-highlight-btn";
        deleteBtn.title = "Delete Highlight";
        deleteBtn.innerHTML = `<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" width="1.2em" height="1.2em"><path fill="currentColor" d="M19 4h-3.5l-1-1h-5l-1 1H5v2h14M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6z"/></svg>`;

        deleteBtn.addEventListener("click", () => {
          row.remove();
          if (
            container.querySelectorAll(".highlight-row").length === 0 &&
            emptyText
          ) {
            container.appendChild(emptyText);
          }
        });

        row.appendChild(field);
        row.appendChild(deleteBtn);
        container.appendChild(row);

        input.value = "";
      });
    }

    // Delegação de eventos para exclusão de itens existentes carregados do banco
    if (container) {
      container.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const btn = target.closest(".remove-highlight-btn");
        if (btn) {
          const row = btn.closest(".highlight-row");
          if (row) {
            row.remove();
            if (
              container.querySelectorAll(".highlight-row").length === 0 &&
              emptyText
            ) {
              container.appendChild(emptyText);
            }
          }
        }
      });
    }
  }

  // Inicializa para o formulário de criação
  setupHighlightManager(
    "new-highlight-input",
    "add-new-highlight-btn",
    "new-highlights-container",
    "no-highlights-text",
  );

  // Inicializa para o formulário de edição
  setupHighlightManager(
    "edit-new-highlight-input",
    "edit-add-highlight-btn",
    "edit-highlights-container",
    "edit-no-highlights-text",
  );

  setupAdminImageCompression();

  // Script para atualizar o nome do arquivo selecionado visualmente em tempo real
  document.querySelectorAll('.file-input').forEach((input) => {
    input.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.files && target.files.length > 0) {
        const fileName = target.files[0].name;
        const container = target.closest('div.rounded-xl');
        const span = container?.querySelector('.file-name-display');
        if (span) {
          span.textContent = `Selected: ${fileName}`;
          span.classList.add('text-emerald-700', 'font-medium');
        }
      }
    });
  });
</script>