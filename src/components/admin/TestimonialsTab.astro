---
// src/components/admin/TestimonialsTab.astro
import ContentSaveIcon from "~icons/mdi/content-save";
import PlusIcon from "~icons/mdi/plus";
import DeleteIcon from "~icons/mdi/delete";

const { testimonials } = Astro.props;
---
<section class="rounded-2xl border border-slate-200 bg-white p-3 sm:p-5 shadow-sm">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h2 class="text-base sm:text-lg font-semibold text-[#0b3c5d]">Testimonials</h2>
      <p class="text-xs text-slate-500">Manage customer reviews and feedback.</p>
    </div>
  </div>

  <!-- Adicionar Depoimento -->
  <form method="POST" action="/admin/api/testimonials" class="mb-6 rounded-xl border border-slate-200 bg-slate-50 p-3 grid gap-3">
    <input type="hidden" name="action" value="create" />
    <h3 class="text-xs font-bold text-[#0b3c5d]">Add New Testimonial</h3>
    <div class="grid gap-2 sm:grid-cols-2">
      <input type="text" name="author" required placeholder="Author Name" class="rounded-lg border border-slate-300 px-3 py-2 text-xs bg-white focus:outline-none" />
      <input type="text" name="location" placeholder="Location (e.g. Orlando, FL)" class="rounded-lg border border-slate-300 px-3 py-2 text-xs bg-white focus:outline-none" />
    </div>
    <textarea name="content" rows="2" required placeholder="Testimonial content..." class="rounded-lg border border-slate-300 px-3 py-2 text-xs bg-white focus:outline-none"></textarea>
    <div class="flex justify-end">
      <button type="submit" class="flex items-center gap-1 rounded-full bg-[#0b3c5d] px-4 py-1.5 text-xs font-semibold text-white hover:bg-[#2570a2]">
        <PlusIcon class="w-4 h-4" /> Add Testimonial
      </button>
    </div>
  </form>

  <!-- Lista de Depoimentos -->
  <div class="grid gap-3">
    {testimonials.length === 0 ? (
      <p class="text-xs text-slate-500 italic py-4 text-center">No testimonials registered yet.</p>
    ) : (
      testimonials.map((item: any) => (
        <form method="POST" action="/admin/api/testimonials" class="flex flex-col gap-2 border p-3 rounded-lg bg-white">
          <input type="hidden" name="action" value="update" />
          <input type="hidden" name="id" value={item.id} />
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <input type="text" name="author" value={item.author} class="rounded border border-slate-300 px-2 py-1 text-xs font-bold text-slate-800" />
            <input type="text" name="location" value={item.location || ""} placeholder="Location" class="rounded border border-slate-300 px-2 py-1 text-xs text-slate-600" />
          </div>
          <textarea name="content" rows="2" class="rounded border border-slate-300 px-2 py-1 text-xs text-slate-500">{item.content}</textarea>
          
          <div class="flex justify-end gap-2 pt-1">
            <button type="submit" class="flex items-center gap-1 rounded bg-emerald-600 px-3 py-1.5 text-xs text-white hover:bg-emerald-700">
              <ContentSaveIcon class="w-3.5 h-3.5" /> Save
            </button>
            <button type="submit" name="action" value="delete" class="flex items-center gap-1 rounded bg-red-600 px-3 py-1.5 text-xs text-white hover:bg-red-700" onclick="return confirm('Delete this testimonial?');">
              <DeleteIcon class="w-3.5 h-3.5" /> Delete
            </button>
          </div>
        </form>
      ))
    )}
  </div>
</section>