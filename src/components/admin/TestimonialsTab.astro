---
// src/components/admin/TestimonialsTab.astro
import ContentSaveIcon from "~icons/mdi/content-save";
import PlusIcon from "~icons/mdi/plus";
import DeleteIcon from "~icons/mdi/delete";
import CloudUploadIcon from "~icons/mdi/cloud-upload";

const { testimonials = [], services = [] } = Astro.props;
const selectedServiceId = Astro.url.searchParams.get("service_id") ?? "";

const filteredTestimonials = selectedServiceId === "" 
  ? testimonials 
  : testimonials.filter((t: any) => t.service_id === selectedServiceId);
---

<style>
  .star-rating { display: flex; flex-direction: row-reverse; justify-content: flex-end; gap: 2px; }
  .star-rating input { display: none; }
  .star-rating label { cursor: pointer; font-size: 1.25rem; color: #cbd5e1; transition: color 0.15s; }
  .star-rating label:hover, .star-rating label:hover ~ label, .star-rating input:checked ~ label { color: #fbbf24; }
</style>

<section class="rounded-2xl border border-slate-200 bg-white p-3 sm:p-5 shadow-sm">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-4 border-b pb-3">
    <div>
      <h2 class="text-base sm:text-lg font-semibold text-[#0b3c5d]">Testimonials Management</h2>
      <p class="text-xs text-slate-500">Manage client reviews, ratings, and before/after images.</p>
    </div>

    <div class="flex items-center gap-2 w-full sm:w-auto">
      <select
        class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs bg-white text-slate-800 font-medium focus:outline-none flex-1 sm:w-64"
        onchange="window.location.href = `/admin?tab=testimonial&service_id=${this.value}`"
      >
        <option value="">All Services</option>
        {services.map((s: any) => <option value={s.id} selected={s.id === selectedServiceId}>{s.title}</option>)}
      </select>

      <button type="button" id="open-new-testimonial-modal" class="flex items-center gap-1.5 rounded-full bg-[#0b3c5d] px-5 py-2 text-xs font-semibold text-white hover:bg-[#2570a2] whitespace-nowrap">
        <PlusIcon class="w-4 h-4" /> New Testimonial
      </button>
    </div>
  </div>

  {/* Formulário Novo */}
  <form id="new-testimonial-form" method="POST" action="/admin/api/testimonial" enctype="multipart/form-data" class="hidden mb-6 rounded-xl border border-slate-300 bg-slate-50 p-4 grid gap-3 shadow-inner">
    <input type="hidden" name="action" value="create" />
    
    <div class="grid gap-3 sm:grid-cols-2">
      <label class="grid gap-1 text-xs font-semibold text-slate-700">
        Linked Service *
        <select name="service_id" required class="rounded-lg border border-slate-300 px-3 py-2 text-xs bg-white focus:outline-none">
          <option value="" disabled selected>Select a service...</option>
          {services.map((s: any) => <option value={s.id}>{s.title}</option>)}
        </select>
      </label>

      <label class="grid gap-1 text-xs font-semibold text-slate-700">
        Client Name *
        <input type="text" name="name" required placeholder="John Doe" class="rounded-lg border border-slate-300 px-3 py-2 text-xs bg-white focus:outline-none" />
      </label>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      <label class="grid gap-1 text-xs font-semibold text-slate-700">
        Location (City, State) *
        <input type="text" name="location" required placeholder="Curitiba, PR" class="rounded-lg border border-slate-300 px-3 py-2 text-xs bg-white focus:outline-none" />
      </label>
      <label class="grid gap-1 text-xs font-semibold text-slate-700">
        Date *
        <input type="date" name="date" required class="rounded-lg border border-slate-300 px-3 py-2 text-xs bg-white focus:outline-none" />
      </label>
    </div>

    <div class="grid gap-3 sm:grid-cols-4 items-start">
      <div class="sm:col-span-3">
        <label class="grid gap-1 text-xs font-semibold text-slate-700">
          Testimonial Content *
          <textarea name="content" required rows="3" placeholder="Type the review..." class="rounded-lg border border-slate-300 px-3 py-2 text-xs bg-white focus:outline-none"></textarea>
        </label>
      </div>
      <div class="sm:col-span-1">
        <label class="grid gap-1 text-xs font-semibold text-slate-700">
          Rating *
          <div class="star-rating pt-2">
            {[5, 4, 3, 2, 1].map((num) => (
              <>
                <input type="radio" name="rating" value={num} id={`new-star-${num}`} required checked={num === 5} />
                <label for={`new-star-${num}`}>★</label>
              </>
            ))}
          </div>
        </label>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 border-t pt-3">
      {['before', 'after'].map((type) => (
        <div class="grid gap-1.5">
          <span class="text-xs font-semibold capitalize text-slate-700">{type} Image</span>
          <div class="rounded-xl border border-dashed border-slate-300 p-2.5 text-center bg-white flex items-center justify-between">
             <div class="flex items-center gap-2 truncate">
               <CloudUploadIcon class="w-5 h-5 text-slate-400 shrink-0" />
               <span class="file-name-display text-[11px] text-slate-500 truncate">No file chosen</span>
             </div>
             <label class="rounded-full bg-slate-200 px-3 py-1 text-[10px] text-slate-700 font-semibold cursor-pointer hover:bg-slate-300 shrink-0">
               Browse <input type="file" name={`${type}_image_file`} class="hidden file-input" accept="image/*" />
             </label>
          </div>
        </div>
      ))}
    </div>
    
    <div class="flex justify-end pt-3 border-t">
      <button type="submit" class="flex items-center gap-1.5 rounded-full bg-[#0b3c5d] px-5 py-2 text-xs font-semibold text-white hover:bg-[#2570a2]">
        <ContentSaveIcon class="w-4 h-4" /> Save & Create
      </button>
    </div>
  </form>

  {/* Listagem */}
  <div class="grid gap-4">
    {filteredTestimonials.length === 0 ? (
      <p class="text-xs text-slate-400 italic py-6 text-center">No testimonials found.</p>
    ) : (
      filteredTestimonials.map((t: any) => (
        <form method="POST" action="/admin/api/testimonial" enctype="multipart/form-data" class="bg-slate-50 p-3 rounded-xl border border-slate-200 grid gap-3">
          <input type="hidden" name="action" value="update" />
          <input type="hidden" name="id" value={t.id} />
          
          <div class="grid gap-2 sm:grid-cols-4 items-center">
            <select name="service_id" required class="rounded-lg border border-slate-300 px-2 py-1.5 text-xs bg-white font-medium focus:outline-none">
              {services.map((s: any) => <option value={s.id} selected={s.id === t.service_id}>{s.title}</option>)}
            </select>
            <input type="text" name="name" value={t.name} required placeholder="Client Name" class="rounded-lg border border-slate-300 px-2 py-1.5 text-xs bg-white focus:outline-none" />
            <input type="text" name="location" value={t.location || ""} required placeholder="Location" class="rounded-lg border border-slate-300 px-2 py-1.5 text-xs bg-white focus:outline-none" />
            <input type="date" name="date" value={t.date ? t.date.split('T')[0] : ""} required class="rounded-lg border border-slate-300 px-2 py-1.5 text-xs bg-white focus:outline-none" />
          </div>

          <div class="grid gap-3 sm:grid-cols-4 items-center">
            <div class="sm:col-span-3">
              <textarea name="content" rows="2" required class="w-full rounded-lg border border-slate-300 px-3 py-1.5 text-xs bg-white focus:outline-none">{t.content}</textarea>
            </div>
            <div class="sm:col-span-1 flex justify-sm-start">
              <div class="star-rating">
                {[5, 4, 3, 2, 1].map((num) => (
                  <>
                    <input type="radio" name="rating" value={num} id={`star-${t.id}-${num}`} checked={(t.rating || 5) === num} />
                    <label for={`star-${t.id}-${num}`}>★</label>
                  </>
                ))}
              </div>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2 border-t pt-2">
            {['before', 'after'].map((type) => (
              <div class="grid gap-1.5">
                <span class="text-xs font-semibold capitalize text-slate-700">Current {type} Image</span>
                <div class="flex items-center gap-3">
                  {t[`${type}_image`] && (
                    <img src={t[`${type}_image`].split('?')[0]} alt={type} class="w-10 h-10 object-cover rounded border" />
                  )}
                  <div class="rounded-xl border border-dashed border-slate-300 p-2 text-center bg-white flex items-center justify-between flex-1">
                     <span class="file-name-display text-[10px] text-slate-500 truncate">Replace {type}...</span>
                     <label class="rounded-full bg-slate-200 px-3 py-1 text-[10px] text-slate-700 font-semibold cursor-pointer hover:bg-slate-300 shrink-0">
                       Browse <input type="file" name={`${type}_image_file`} class="hidden file-input" accept="image/*" />
                     </label>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <div class="flex justify-end gap-2 pt-2 border-t">
              <button type="submit" class="flex items-center gap-1.5 rounded-full bg-[#0b3c5d] px-4 py-1.5 text-xs font-semibold text-white hover:bg-[#2570a2]">
                <ContentSaveIcon class="w-4 h-4" /> Save Changes
              </button>
              <button type="submit" formaction="/admin/api/testimonials/delete" class="flex items-center gap-1.5 rounded-full bg-red-600 px-4 py-1.5 text-xs font-semibold text-white hover:bg-red-700" onclick="return confirm('Delete this testimonial?');">
                <DeleteIcon class="w-4 h-4" /> Delete
              </button>
          </div>
        </form>
      ))
    )}
  </div>
</section>

<script>
  const openNewBtn = document.getElementById("open-new-testimonial-modal");
  const newForm = document.getElementById("new-testimonial-form");
  openNewBtn?.addEventListener("click", () => newForm?.classList.toggle("hidden"));

  document.querySelectorAll('.file-input').forEach((input) => {
    input.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.files && target.files.length > 0) {
        const fileName = target.files.length > 1 ? `${target.files.length} files selected` : target.files[0].name;
        const container = target.closest('div');
        const span = container?.parentElement?.querySelector('.file-name-display') || container?.querySelector('.file-name-display');
        if (span) {
          span.textContent = fileName;
          span.classList.add('text-emerald-700', 'font-medium');
        }
      }
    });
  });
</script>