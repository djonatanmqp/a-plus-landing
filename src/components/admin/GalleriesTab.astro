---
// src/components/admin/GalleriesTab.astro
import ContentSaveIcon from "~icons/mdi/content-save";
import CloudUploadIcon from "~icons/mdi/cloud-upload";
import DeleteIcon from "~icons/mdi/delete";

const { galleries = [], services = [] } = Astro.props;
const selectedServiceId = Astro.url.searchParams.get("service_id") || "";

// Encontra o serviço selecionado e extrai o array de imagens armazenado no campo `images`
const selectedService = services.find((s: any) => s.id === selectedServiceId);
const currentImages: string[] = selectedService?.images || [];
---

<section class="rounded-2xl border border-slate-200 bg-white p-3 sm:p-5 shadow-sm">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-4 border-b pb-3">
    <div>
      <h2 class="text-base sm:text-lg font-semibold text-[#0b3c5d]">Galleries Management</h2>
      <p class="text-xs text-slate-500">Upload and manage project images linked to specific services (converted & compressed to WebP).</p>
    </div>

    <!-- Seletor de Serviço (Dropdown) -->
    <div class="flex items-center gap-2 w-full sm:w-auto">
      <select
        id="gallery-service-selector"
        class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs bg-white text-slate-800 font-medium focus:outline-none flex-1 sm:w-64"
        onchange="window.location.href = `/admin?tab=galleries&service_id=${this.value}`"
      >
        <option value="" disabled selected={!selectedServiceId}>Select a service...</option>
        {services.map((s: any) => (
          <option value={s.id} selected={s.id === selectedServiceId}>
            {s.title}
          </option>
        ))}
      </select>
    </div>
  </div>

  {/* Formulário para Adicionar Múltiplas Imagens */}
  <form
    method="POST"
    action="/admin/api/gallery"
    enctype="multipart/form-data"
    class="grid gap-5"
  >
    <input type="hidden" name="action" value="add_images" />
    <input type="hidden" name="service_id" value={selectedServiceId} />

    {selectedServiceId === "" && (
      <div class="rounded-lg bg-amber-50 border border-amber-200 p-2.5 text-amber-800 text-xs">
        ⚠️ Warning: No service selected in the dropdown above. Please select a service first, or the images won't be properly linked.
      </div>
    )}

    <div class="grid gap-1.5">
      <span class="text-xs font-semibold text-slate-700">Add Photos to Gallery (Multiple)</span>
      
      <div class="rounded-xl border border-dashed border-slate-300 p-6 text-center bg-slate-50 flex flex-col items-center justify-center gap-2 relative">
        <CloudUploadIcon class="w-8 h-8 text-slate-400" />
        <p class="file-name-display text-xs text-slate-500">Drag and drop project images here or click to upload.</p>
        <span class="text-[10px] text-slate-400">Images will be automatically converted and compressed into WebP format.</span>
        
        <label class="mt-2 rounded-full bg-[#0b3c5d] px-4 py-1.5 text-xs font-semibold text-white cursor-pointer hover:bg-[#2570a2] whitespace-nowrap z-10">
          Browse Images
          <input 
            type="file" 
            name="gallery_images" 
            multiple 
            accept="image/*" 
            class="hidden file-input" 
          />
        </label>
      </div>
    </div>

    {/* Botão de Salvar / Enviar Imagens */}
    <div class="flex justify-end pt-3 border-t">
      <button
        type="submit"
        class="flex items-center gap-1.5 rounded-full bg-[#0b3c5d] px-5 py-2 text-xs font-semibold text-white hover:bg-[#2570a2]"
      >
        <ContentSaveIcon class="w-4 h-4" /> Save Gallery Images
      </button>
    </div>
  </form>

  {/* Listagem das Imagens Já Salvas para o Serviço Selecionado */}
  {selectedServiceId && (
    <div class="mt-8 border-t pt-5">
      <h3 class="text-xs font-bold text-[#0b3c5d] uppercase tracking-wider mb-3">
        Current Gallery Images for this Service ({currentImages.length})
      </h3>

      <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {currentImages.length === 0 ? (
          <p class="text-xs text-slate-400 italic sm:col-span-2 md:col-span-3">
            No images uploaded for this service yet. Use the form above to add photos.
          </p>
        ) : (
          currentImages.map((imageUrl: string) => (
            <div class="rounded-xl border border-slate-200 bg-slate-50 overflow-hidden flex flex-col justify-between shadow-sm">
              <div class="h-32 w-full bg-slate-200 overflow-hidden relative">
                <img 
                  src={imageUrl.split('?')[0]} 
                  alt="Gallery project" 
                  class="w-full h-full object-cover"
                />
              </div>
              
              <div class="p-2.5 border-t border-slate-200 flex items-center justify-between bg-white">
                <span class="text-[10px] text-slate-500 truncate max-w-[120px]">
                  {imageUrl ? imageUrl.split('/').pop()?.split('?')[0] : ''}
                </span>
                
                <form method="POST" action="/admin/api/gallery/delete" onsubmit="return confirm('Are you sure you want to delete this image?');">
                  <input type="hidden" name="serviceId" value={selectedServiceId} />
                  <input type="hidden" name="imageUrl" value={imageUrl} />
                  <button
                    type="submit"
                    class="flex items-center gap-1 rounded bg-red-600 px-2 py-1 text-[10px] text-white hover:bg-red-700"
                    title="Delete Image"
                  >
                    <DeleteIcon class="w-3 h-3" /> Delete
                  </button>
                </form>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  )}
</section>

<script>
  import { setupAdminImageCompression } from "../../scripts/admin-image-compression";

  setupAdminImageCompression();

  // Script para atualizar os nomes dos arquivos selecionados em tempo real
  document.querySelectorAll('.file-input').forEach((input) => {
    input.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.files && target.files.length > 0) {
        const fileNames = Array.from(target.files).map(file => file.name).join(', ');
        const container = target.closest('div.rounded-xl');
        const span = container?.querySelector('.file-name-display');
        if (span) {
          span.textContent = `Selected (${target.files.length}): ${fileNames}`;
          span.classList.add('text-emerald-700', 'font-medium');
        }
      }
    });
  });
</script>