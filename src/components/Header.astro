---
// src/components/Header.astro
import { supabase } from "../lib/supabase.js";

const { data: settings } = await supabase
  .from("settings")
  .select("*")
  .eq("id", "company")
  .single();

const company: any = settings || {};

export interface BreadcrumbItem {
    label: string;
    href?: string;
    current?: boolean;
}

interface Props {
    headerTitle?: string;
    headerSubtitle?: string;
    breadcrumb?: BreadcrumbItem[];
    isHome?: boolean;
    showServicesLinks?: boolean;
    hideMenu?: boolean;
}

const {
    headerTitle = company?.name || "A-Plus Pavers & Grass LLC",
    headerSubtitle = (company?.tagline || "").toUpperCase(),
    breadcrumb = [],
    isHome = false,
    showServicesLinks = false,
    hideMenu = false,
} = Astro.props as Props;

const servicesHref = isHome ? "#services" : "/services";
const galleryHref = isHome ? "#gallery-driveways" : "/services";
const contactHref = isHome ? "#contact" : "/#contact";
---

<header
    class="relative z-40 text-white py-2 sm:py-3 md:py-4 px-4 sm:px-6 lg:px-8 border-b-4 border-[#328cc1] bg-repeat bg-center"
    style="background-image: linear-gradient(rgba(128, 128, 128, 0.50), rgba(128, 128, 128, 0.50)), url('/paver-pattern.png'); background-size: auto, 180px;"
>
    <div
        class="max-w-6xl mx-auto flex flex-row items-center justify-between gap-4 sm:gap-6 relative"
    >
        <div class="flex items-center justify-start relative flex-1 min-w-0">
            <a
                href="/"
                aria-label="Go to homepage"
                class="absolute left-0 z-30 -bottom-2 sm:-bottom-3 md:-bottom-4 translate-y-1/2 inline-flex"
            >
                <img
                    src="/logo.png"
                    alt={`${company?.name || 'Company'} Logo`}
                    class="w-20 sm:w-28 md:w-36 h-auto drop-shadow-lg transition-transform duration-300 hover:scale-105"
                    loading="eager"
                    fetchpriority="high"
                />
            </a>

            <div
                class="pl-24 sm:pl-32 md:pl-44 py-0.5 relative z-10 flex flex-col justify-center min-h-0 min-w-0 w-full"
            >
                <h1
                    class="m-0 p-0 tracking-tight leading-none min-w-0 w-full"
                    style="text-shadow: 0 0 15px rgba(255, 255, 255, 0.85), 0 0 5px rgba(255, 255, 255, 0.5);"
                >
                    <span
                        id="header-title"
                        class="text-[#0b3c5d] text-xl sm:text-2xl md:text-3xl lg:text-4xl font-black block"
                        style="white-space: nowrap !important;"
                    >
                        {headerTitle}
                    </span>
                    <span
                        class="text-white font-bold text-[9px] sm:text-xs md:text-[13px] lg:text-sm tracking-wide hidden sm:block mt-1 sm:mt-1.5 whitespace-pre-line max-w-xl md:max-w-2xl lg:max-w-4xl opacity-95 leading-tight md:normal-case"
                    >
                        {headerSubtitle}
                    </span>
                </h1>
            </div>
        </div>

        {
            !hideMenu && (
                <div class="relative z-50 flex items-center gap-4 shrink-0">
                    <nav class="hidden md:flex items-center gap-6 font-bold text-sm uppercase tracking-wider text-[#0b3c5d]">
                        {showServicesLinks && (
                            <>
                                <a
                                    href="/services"
                                    class="hover:text-[#328cc1] transition-colors drop-shadow-sm"
                                    style="text-shadow: 0 0 15px rgba(255, 255, 255, 0.85), 0 0 5px rgba(255, 255, 255, 0.5);"
                                >
                                    All Services
                                </a>
                                <a
                                    href={servicesHref}
                                    class="hover:text-[#328cc1] transition-colors drop-shadow-sm"
                                    style="text-shadow: 0 0 15px rgba(255, 255, 255, 0.85), 0 0 5px rgba(255, 255, 255, 0.5);"
                                >
                                    Services
                                </a>
                                <a
                                    href={galleryHref}
                                    class="hover:text-[#328cc1] transition-colors drop-shadow-sm"
                                    style="text-shadow: 0 0 15px rgba(255, 255, 255, 0.85), 0 0 5px rgba(255, 255, 255, 0.5);"
                                >
                                    Gallery
                                </a>
                            </>
                        )}
                        <a
                            href={contactHref}
                            class="hover:text-[#328cc1] transition-colors drop-shadow-sm bg-[#0b3c5d] text-white px-4 py-2 rounded shadow-sm"
                        >
                            Contact Us
                        </a>
                    </nav>

                    <button
                        id="menu-toggle"
                        class="md:hidden flex flex-col justify-between w-6 h-4 text-white focus:outline-none bg-black/20 p-2 box-content rounded"
                        aria-label="Toggle navigation menu"
                    >
                        <span class="w-6 h-0.5 bg-[#0b3c5d] transition-all duration-300 origin-left line-1" />
                        <span class="w-6 h-0.5 bg-[#0b3c5d] transition-all duration-300 line-2" />
                        <span class="w-6 h-0.5 bg-[#0b3c5d] transition-all duration-300 origin-left line-3" />
                    </button>
                </div>
            )
        }
    </div>

    {
        !hideMenu && (
            <div
                id="mobile-menu"
                class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm pointer-events-none opacity-0 transition-all duration-300 md:hidden"
            >
                <div class="absolute right-0 top-0 h-full w-64 bg-white shadow-2xl p-6 flex flex-col translate-x-full transition-transform duration-300 ease-out menu-content">
                    <div class="flex justify-between items-center mb-8 border-b pb-4">
                        <span class="font-extrabold text-[#0b3c5d] text-lg">
                            Navigation
                        </span>
                        <button
                            id="menu-close"
                            class="text-2xl text-gray-400 hover:text-black leading-none focus:outline-none"
                        >
                            &times;
                        </button>
                    </div>
                    <nav class="flex flex-col gap-5 text-base font-bold uppercase tracking-wider text-[#0b3c5d]">
                        {!isHome && (
                            <a
                                href="/"
                                class="mobile-link hover:text-[#328cc1] py-2 border-b border-gray-100"
                            >
                                Home
                            </a>
                        )}
                        <a
                            href="/services"
                            class="mobile-link hover:text-[#328cc1] py-2 border-b border-gray-100"
                        >
                            All Services
                        </a>
                        <a
                            href={servicesHref}
                            class="mobile-link hover:text-[#328cc1] py-2 border-b border-gray-100"
                        >
                            Our Services
                        </a>
                        <a
                            href={galleryHref}
                            class="mobile-link hover:text-[#328cc1] py-2 border-b border-gray-100"
                        >
                            Photo Gallery
                        </a>
                        <a
                            href={contactHref}
                            class="mobile-link bg-[#0b3c5d] text-white text-center py-3 rounded-md shadow mt-4 block"
                        >
                            Get Free Estimate
                        </a>
                    </nav>
                </div>
            </div>
        )
    }
</header>

{
    breadcrumb.length > 0 && (
        <nav 
            class="max-w-6xl mx-auto px-4 py-2 text-xs sm:text-sm text-gray-500 flex flex-nowrap items-center gap-1.5 sm:gap-2 pl-24 sm:pl-32 md:pl-44 overflow-x-auto whitespace-nowrap [-ms-overflow-style:none] scrollbar-none [&::-webkit-scrollbar]:hidden"
        >
            {breadcrumb.map((item, index) => (
                <span class="flex items-center gap-1.5 sm:gap-2 shrink-0">
                    {index > 0 && <span class="text-gray-400">/</span>}
                    {item.href && !item.current ? (
                        <a href={item.href} class="hover:text-[#328cc1] transition-colors">
                            {item.label}
                        </a>
                    ) : (
                        <span class="text-[#0b3c5d] font-medium truncate max-w-50 sm:max-w-none">
                            {item.label}
                        </span>
                    )}
                </span>
            ))}
        </nav>
    )
}

<script>
    function setupMobileMenu() {
        const toggleBtn = document.getElementById('menu-toggle');
        const closeBtn = document.getElementById('menu-close');
        const mobileMenu = document.getElementById('mobile-menu');
        
        const menuContent = mobileMenu?.querySelector('.menu-content');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        if (!toggleBtn || !mobileMenu || !menuContent || !closeBtn) return;

        function openMenu() {
            mobileMenu!.classList.remove('pointer-events-none', 'opacity-0');
            menuContent!.classList.remove('translate-x-full');
        }

        function closeMenu() {
            mobileMenu!.classList.add('pointer-events-none', 'opacity-0');
            menuContent!.classList.add('translate-x-full');
        }

        toggleBtn.addEventListener('click', openMenu);
        closeBtn.addEventListener('click', closeMenu);
        
        mobileMenu.addEventListener('click', (e) => {
            if (e.target === mobileMenu) closeMenu();
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', closeMenu);
        });
    }

    function setupHeaderAutofit() {
        const title = document.getElementById('header-title');
        if (!title) return;

        title.style.fontSize = '';

        if (window.innerWidth >= 640) return;

        const header = title.closest('header');
        if (!header) return;

        const menu = header.querySelector('.flex-shrink-0');
        const menuWidth = menu ? (menu as HTMLElement).offsetWidth : 0;

        const safetyBuffer = 15;
        const availableWidth = header.clientWidth - 96 - menuWidth - 32 - safetyBuffer;

        let fontSize = 20;
        title.style.fontSize = `${fontSize}px`;

        while (title.scrollWidth > availableWidth && fontSize > 13.5) {
            fontSize -= 0.5;
            title.style.fontSize = `${fontSize}px`;
        }
    }

    setupMobileMenu();
    setupHeaderAutofit();

    window.addEventListener('resize', setupHeaderAutofit);
    document.addEventListener('astro:after-swap', () => {
        setupMobileMenu();
        setupHeaderAutofit();
    });
</script>