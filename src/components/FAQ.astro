---
// src/components/FAQ.astro
import { supabase } from "../lib/supabase.js";

interface Props {
  serviceId?: string;
}

const { serviceId = "global" } = Astro.props;

// 1. Busca os dados filtrando diretamente na query do Supabase
let query = supabase.from("faqs").select("*");

if (serviceId === "global") {
  query = query.is("service_id", null);
} else {
  query = query.eq("service_id", serviceId);
}

const { data: faqData = [] } = await query;
---

<section id="faq" class="max-w-6xl mx-auto px-4 py-2">
  <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
    <h2 class="text-3xl font-extrabold text-[#0b3c5d] mb-4">Frequently Asked Questions</h2>
    <p class="text-sm text-gray-600 mb-8">
      Answers to the most common questions from homeowners.
    </p>

    {faqData && faqData.length > 0 ? (
      <div class="space-y-6">
        {faqData.map((item: any) => (
          <article class="border-b border-gray-50 pb-4 last:border-none last:pb-0">
            <h3 class="text-lg font-semibold text-[#0b3c5d] mb-2">
              {item.question}
            </h3>
            <p class="text-gray-600 leading-relaxed">
              {item.answer}
            </p>
          </article>
        ))}
      </div>
    ) : (
      <p class="text-gray-500 italic">No frequently asked questions available.</p>
    )}
  </div>
</section>