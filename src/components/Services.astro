---
// src/components/Services.astro
---

<section id="services" class="max-w-6xl mx-auto px-4 pt-6">
    <div
        class="bg-white rounded-xl p-8 shadow-sm border border-gray-100 relative overflow-hidden"
    >
        <div
            class="absolute top-0 right-0 w-32 h-32 opacity-[0.03] pointer-events-none select-none"
        >
            <img
                src="/paver-pattern.png"
                alt=""
                class="w-full h-full object-cover"
            />
        </div>

        <h2
            class="text-3xl font-extrabold text-[#0b3c5d] mb-6 relative inline-block after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-12 after:h-1 after:bg-[#328cc1] pb-2"
        >
            Our Services
        </h2>

        <div
            class="space-y-6 text-gray-600 leading-relaxed text-base sm:text-lg"
        >
            <div class="flex items-start gap-3">
                <span class="text-[#328cc1] text-xl select-none">▪</span>
                <p>
                    Professional paver installation for driveways, patios and
                    walkways in Orlando, Winter Park, Lake Nona and surrounding
                    areas.
                </p>
            </div>
            <div class="flex items-start gap-3">
                <span class="text-[#328cc1] text-xl select-none">▪</span>
                <p>
                    Expert artificial turf and sod installation designed for
                    Florida heat, humidity, and modern lawn performance.
                </p>
            </div>
            <div class="flex items-start gap-3">
                <span class="text-[#328cc1] text-xl select-none">▪</span>
                <p>
                    Fast, reliable service with local Orlando project estimates
                    and dedicated customer care.
                </p>
            </div>
            <a
                href={`/services`}
                class="mt-4 inline-flex items-center justify-center rounded-full bg-[#328cc1] px-4 py-2 text-xs font-bold uppercase tracking-wider text-white transition hover:bg-[#2570a2]"
            >
                All Services
            </a>
        </div>
    </div>
</section>
