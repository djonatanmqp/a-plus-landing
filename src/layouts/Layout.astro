---
// src/layouts/Layout.astro
interface Props {
	title: string;
}

const { title } = Astro.props;

// Força a inclusão dos estilos globais do Tailwind caso a automação tenha pulado
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Premier choice for pavers and grass in Orlando" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body class="bg-gray-50 text-gray-800 font-['Montserrat',sans-serif] antialiased">
		<slot />
	</body>
</html>