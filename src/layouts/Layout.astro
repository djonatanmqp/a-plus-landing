---
// src/layouts/Layout.astro
interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;

const origin = new URL(Astro.request.url).origin;
const currentUrl = new URL(Astro.request.url).href;
const metaDescription = description ?? "A-Plus Pavers & Grass LLC delivers premium driveway pavers, patios, walkways, artificial turf and sod installation across Orlando, FL.";

// Força a inclusão dos estilos globais do Tailwind caso a automação tenha pulado
import '../styles/global.css';
import ZoomModal from '../components/ZoomModal.astro';
import Analytics from '@vercel/analytics/astro';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={metaDescription} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#0b3c5d" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="canonical" href={currentUrl} />
		<title>{title}</title>
		<!-- Assinatura Técnica (Meta Tags) -->
    	<meta name="author" content="Djonatan M. Q. Piehowiak - Full Stack Developer & UX/UI Designer" />
    	<meta name="designer" content="Djonatan M. Q. Piehowiak" />
    	<meta name="reply-to" content="djonatan.piehowiak@gmail.com" />

    	<!-- Comentário direto no HTML (Aparece ao "Exibir código fonte da página") -->
    	<!-- 
        	DESIGN & DEVELOPMENT BY:
        	- Name: Djonatan M. Q. Piehowiak
        	- Role: Web Developer & UX/UI Designer
        	- Contact: djonatan.piehowiak@gmail.com
    	-->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={currentUrl} />
		<meta property="og:site_name" content="A-Plus Pavers & Grass LLC" />
		<meta property="og:image" content="/logo.png" />
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={metaDescription} />
		<meta property="twitter:image" content="/logo.png" />
		<meta name="robots" content="index, follow" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
		<script type="application/ld+json">
		{JSON.stringify({
			"@context": "https://schema.org",
			"@type": "LocalBusiness",
			"name": "A-Plus Pavers & Grass LLC",
			"image": [
				"/logo.png"
			],
			"@id": currentUrl,
			"url": currentUrl,
			"telephone": "(407) 123-4567",
			"email": "info@apluspaversgrass.com",
			"address": {
				"@type": "PostalAddress",
				"streetAddress": "Orlando Service Area",
				"addressLocality": "Orlando",
				"addressRegion": "FL",
				"postalCode": "32801",
				"addressCountry": "US"
			},
			"geo": {
				"@type": "GeoCoordinates",
				"latitude": 28.538336,
				"longitude": -81.379234
			},
			"areaServed": {
				"@type": "GeoCircle",
				"geoMidpoint": {
					"@type": "GeoCoordinates",
					"latitude": 28.538336,
					"longitude": -81.379234
				},
				"geoRadius": 50
			},
			"openingHoursSpecification": [
				{
					"@type": "OpeningHoursSpecification",
					"dayOfWeek": [
						"Monday",
						"Tuesday",
						"Wednesday",
						"Thursday",
						"Friday"
					],
					"opens": "08:00",
					"closes": "18:00"
				},
				{
					"@type": "OpeningHoursSpecification",
					"dayOfWeek": ["Saturday"],
					"opens": "09:00",
					"closes": "16:00"
				}
			],
			"sameAs": []
		})}
		</script>
	</head>
	<body class="bg-gray-50 text-gray-800 font-['Montserrat',sans-serif] antialiased">
		<slot />
		<ZoomModal />
    	<script src="/assets/zoom.js" type="module"></script>
    	<Analytics />

    	<script>
    		// Redirect OAuth responses to the appropriate handlers:
    		// - If the provider returns an access_token in the hash, forward to /admin#access_token=... so the admin page can process it client-side.
    		// - If the provider returns a ?code=... on the root, forward it to /admin/api/auth-callback so the server can exchange it.
    		(function () {
    			try {
    				if (typeof window === 'undefined') return;
    				const url = new URL(window.location.href);
    				const code = url.searchParams.get('code');
    				const hash = window.location.hash || '';

    				// If hash contains access_token and we're not on /admin, redirect to /admin with the hash
    				if (hash.includes('access_token')) {
    					if (!window.location.pathname.startsWith('/admin')) {
    						window.location.replace('/admin' + hash + window.location.search);
    						return;
    					}
    					// If we're already on /admin, admin.astro will handle the hash
    				}

    				// Handle code query param redirected to root — forward to server callback handler
    				if (code) {
    					// If we're already on the server callback path, do nothing
    					if (!window.location.pathname.startsWith('/admin/api/auth-callback')) {
    						const dest = '/admin/api/auth-callback' + window.location.search;
    						window.location.replace(dest);
    					}
    				}
    			} catch (e) {
    				// Erro silencioso no helper de redirect
    			}
    		})();
    	</script>
	</body>
</html>