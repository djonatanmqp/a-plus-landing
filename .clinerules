│   │   ├── services.astro     # Listagem de serviços
│   │   ├── services/[id].astro# Página de detalhe dinâmico por serviço
│   │   └── admin/api/         # API Endpoints SSR (JSON) para CRUD e Autenticação
│   ├── scripts/               # Scripts client-side (ex: zoom.js)
│   ├── styles/                # CSS global e imports Tailwind (`global.css`)
│   ├── types/                 # Definições de tipos customizados TypeScript
│   └── content.config.ts      # Coleções de conteúdo Astro (Zod schema)
├── astro.config.mjs           # Configuração do Astro, Vite, Tailwind e Icons
├── package.json               # Dependências e scripts do projeto
└── tsconfig.json              # Configuração TypeScript estrita

